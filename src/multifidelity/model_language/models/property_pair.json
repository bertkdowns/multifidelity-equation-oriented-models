{
  "id": "property_pair",
  "description": "Generic pair of independent pressure-enthalpy property calculations using a configured package.",
  "model_parameters": {
    "FluidProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa"
            },
            "enthalpy": {
              "unit": "J/kg"
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "density": {
              "unit": "kg/m**3"
            },
            "heat_capacity": {
              "unit": "J/kg/K"
            },
            "viscosity": {
              "unit": "Pa*s"
            },
            "temperature": {
              "unit": "K"
            },
            "entropy": {
              "unit": "J/kg/K"
            }
          }
        }
      }
    }
  },
  "structs": {
    "inlet_state": {
      "direction": "input",
      "variables": {
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "outlet_state": {
      "direction": "input",
      "variables": {
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "inlet_properties": {
      "direction": "output",
      "variables": {
        "density": {
          "unit": "kg/m**3"
        },
        "heat_capacity": {
          "unit": "J/kg/K"
        },
        "viscosity": {
          "unit": "Pa*s"
        },
        "temperature": {
          "unit": "K"
        },
        "entropy": {
          "unit": "J/kg/K"
        }
      }
    },
    "outlet_properties": {
      "direction": "output",
      "variables": {
        "density": {
          "unit": "kg/m**3"
        },
        "heat_capacity": {
          "unit": "J/kg/K"
        },
        "viscosity": {
          "unit": "Pa*s"
        },
        "temperature": {
          "unit": "K"
        },
        "entropy": {
          "unit": "J/kg/K"
        }
      }
    }
  },
  "relationships": {
    "evaluate": {
      "models": {
        "inlet": {
          "model_parameter": "FluidProperties"
        },
        "outlet": {
          "model_parameter": "FluidProperties"
        }
      },
      "constraints": {},
      "connections": {
        "inlet_state": {
          "from": "inlet_state",
          "to": "inlet.state"
        },
        "inlet_properties": {
          "from": "inlet.properties",
          "to": "inlet_properties"
        },
        "outlet_state": {
          "from": "outlet_state",
          "to": "outlet.state"
        },
        "outlet_properties": {
          "from": "outlet.properties",
          "to": "outlet_properties"
        }
      }
    }
  }
}
