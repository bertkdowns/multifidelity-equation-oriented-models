{
  "id": "property_pair",
  "description": "Generic pair of independent pressure-enthalpy property calculations using a configured package.",
  "model_parameters": {
    "FluidProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa",
              "dimensions": [
                "time"
              ]
            },
            "enthalpy": {
              "unit": "J/kg",
              "dimensions": [
                "time"
              ]
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "density": {
              "unit": "kg/m**3",
              "dimensions": [
                "time"
              ]
            },
            "heat_capacity": {
              "unit": "J/kg/K",
              "dimensions": [
                "time"
              ]
            },
            "viscosity": {
              "unit": "Pa*s",
              "dimensions": [
                "time"
              ]
            },
            "temperature": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            },
            "entropy": {
              "unit": "J/kg/K",
              "dimensions": [
                "time"
              ]
            }
          }
        }
      }
    }
  },
  "structs": {
    "inlet_state": {
      "direction": "input",
      "variables": {
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "outlet_state": {
      "direction": "input",
      "variables": {
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "inlet_properties": {
      "direction": "output",
      "variables": {
        "density": {
          "unit": "kg/m**3",
          "dimensions": [
            "time"
          ]
        },
        "heat_capacity": {
          "unit": "J/kg/K",
          "dimensions": [
            "time"
          ]
        },
        "viscosity": {
          "unit": "Pa*s",
          "dimensions": [
            "time"
          ]
        },
        "temperature": {
          "unit": "K",
          "dimensions": [
            "time"
          ]
        },
        "entropy": {
          "unit": "J/kg/K",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "outlet_properties": {
      "direction": "output",
      "variables": {
        "density": {
          "unit": "kg/m**3",
          "dimensions": [
            "time"
          ]
        },
        "heat_capacity": {
          "unit": "J/kg/K",
          "dimensions": [
            "time"
          ]
        },
        "viscosity": {
          "unit": "Pa*s",
          "dimensions": [
            "time"
          ]
        },
        "temperature": {
          "unit": "K",
          "dimensions": [
            "time"
          ]
        },
        "entropy": {
          "unit": "J/kg/K",
          "dimensions": [
            "time"
          ]
        }
      }
    }
  },
  "relationships": {
    "evaluate": {
      "models": {
        "inlet": {
          "model_parameter": "FluidProperties",
          "domain_bindings": {
            "time": "time"
          }
        },
        "outlet": {
          "model_parameter": "FluidProperties",
          "domain_bindings": {
            "time": "time"
          }
        }
      },
      "constraints": {
        "inlet_density": {
          "lhs": "inlet_properties.density[t]",
          "rhs": "inlet.properties.density[t]",
          "determines": "inlet_properties.density[t]",
          "for_each": {
            "t": "time"
          }
        },
        "inlet_heat_capacity": {
          "lhs": "inlet_properties.heat_capacity[t]",
          "rhs": "inlet.properties.heat_capacity[t]",
          "determines": "inlet_properties.heat_capacity[t]",
          "for_each": {
            "t": "time"
          }
        },
        "inlet_viscosity": {
          "lhs": "inlet_properties.viscosity[t]",
          "rhs": "inlet.properties.viscosity[t]",
          "determines": "inlet_properties.viscosity[t]",
          "for_each": {
            "t": "time"
          }
        },
        "inlet_temperature": {
          "lhs": "inlet_properties.temperature[t]",
          "rhs": "inlet.properties.temperature[t]",
          "determines": "inlet_properties.temperature[t]",
          "for_each": {
            "t": "time"
          }
        },
        "inlet_entropy": {
          "lhs": "inlet_properties.entropy[t]",
          "rhs": "inlet.properties.entropy[t]",
          "determines": "inlet_properties.entropy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "outlet_density": {
          "lhs": "outlet_properties.density[t]",
          "rhs": "outlet.properties.density[t]",
          "determines": "outlet_properties.density[t]",
          "for_each": {
            "t": "time"
          }
        },
        "outlet_heat_capacity": {
          "lhs": "outlet_properties.heat_capacity[t]",
          "rhs": "outlet.properties.heat_capacity[t]",
          "determines": "outlet_properties.heat_capacity[t]",
          "for_each": {
            "t": "time"
          }
        },
        "outlet_viscosity": {
          "lhs": "outlet_properties.viscosity[t]",
          "rhs": "outlet.properties.viscosity[t]",
          "determines": "outlet_properties.viscosity[t]",
          "for_each": {
            "t": "time"
          }
        },
        "outlet_temperature": {
          "lhs": "outlet_properties.temperature[t]",
          "rhs": "outlet.properties.temperature[t]",
          "determines": "outlet_properties.temperature[t]",
          "for_each": {
            "t": "time"
          }
        },
        "outlet_entropy": {
          "lhs": "outlet_properties.entropy[t]",
          "rhs": "outlet.properties.entropy[t]",
          "determines": "outlet_properties.entropy[t]",
          "for_each": {
            "t": "time"
          }
        }
      },
      "connections": {
        "inlet_state": {
          "from": "inlet_state",
          "to": "inlet.state"
        },
        "outlet_state": {
          "from": "outlet_state",
          "to": "outlet.state"
        }
      }
    }
  },
  "domains": {
    "time": {
      "kind": "time"
    }
  }
}
