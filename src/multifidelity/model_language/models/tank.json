{
  "id": "tank",
  "description": "Well-mixed liquid tank with PH streams, property-package density, prescribed pressure, mass and internal-energy inventories; no pressure dynamics or kinetic/potential energy.",
  "domains": {
    "time": {
      "kind": "time"
    }
  },
  "structs": {
    "inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05
        }
      }
    },
    "withdrawal": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "bounds": {
            "min": 0
          },
          "scale": 1
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "area": {
          "unit": "m**2",
          "bounds": {
            "min": 1e-08
          },
          "scale": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05
        }
      }
    },
    "loss": {
      "direction": "input",
      "variables": {
        "heat": {
          "unit": "W",
          "dimensions": [
            "time"
          ],
          "scale": 0.0001
        }
      }
    },
    "inventory": {
      "direction": "output",
      "variables": {
        "level": {
          "unit": "m",
          "dimensions": [
            "time"
          ],
          "bounds": {
            "min": 1e-08
          },
          "scale": 1
        },
        "energy": {
          "unit": "J",
          "dimensions": [
            "time"
          ],
          "scale": 1e-08
        },
        "temperature": {
          "unit": "K",
          "dimensions": [
            "time"
          ],
          "bounds": {
            "min": 0
          },
          "scale": 0.0033333333333333335
        },
        "mass": {
          "unit": "kg",
          "dimensions": [
            "time"
          ],
          "bounds": {
            "min": 1e-08
          },
          "scale": 0.001
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05
        }
      }
    },
    "rates": {
      "direction": "output",
      "variables": {
        "mass": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1
        },
        "energy": {
          "unit": "W",
          "dimensions": [
            "time"
          ],
          "scale": 0.0001
        }
      }
    },
    "outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05
        }
      }
    }
  },
  "relationships": {
    "mixed": {
      "constraints": {
        "outlet_flow": {
          "for_each": {
            "t": "time"
          },
          "lhs": "outlet.flow[t]",
          "rhs": "withdrawal.flow[t]",
          "determines": "outlet.flow[t]"
        },
        "outlet_pressure": {
          "for_each": {
            "t": "time"
          },
          "lhs": "outlet.pressure[t]",
          "rhs": "parameters.pressure[t]",
          "determines": "outlet.pressure[t]"
        },
        "outlet_enthalpy": {
          "for_each": {
            "t": "time"
          },
          "lhs": "outlet.enthalpy[t]",
          "rhs": "inventory.enthalpy[t]",
          "determines": "outlet.enthalpy[t]"
        },
        "contents_flow": {
          "for_each": {
            "t": "time"
          },
          "lhs": "contents_state.state.flow[t]",
          "rhs": "outlet.flow[t]",
          "determines": "contents_state.state.flow[t]"
        },
        "contents_pressure": {
          "for_each": {
            "t": "time"
          },
          "lhs": "contents_state.state.pressure[t]",
          "rhs": "parameters.pressure[t]",
          "determines": "contents_state.state.pressure[t]"
        },
        "contents_enthalpy": {
          "for_each": {
            "t": "time"
          },
          "lhs": "contents_state.state.enthalpy[t]",
          "rhs": "inventory.enthalpy[t]",
          "determines": "contents_state.state.enthalpy[t]"
        },
        "temperature": {
          "for_each": {
            "t": "time"
          },
          "lhs": "inventory.temperature[t]",
          "rhs": "contents_state.properties.temperature[t]",
          "determines": "inventory.temperature[t]"
        },
        "level": {
          "for_each": {
            "t": "time"
          },
          "lhs": "inventory.mass[t]",
          "rhs": "contents_state.properties.density[t] * parameters.area * inventory.level[t]",
          "determines": "inventory.level[t]"
        },
        "thermal_state": {
          "for_each": {
            "t": "time"
          },
          "lhs": "inventory.energy[t]",
          "rhs": "inventory.mass[t] * inventory.enthalpy[t] - parameters.pressure[t] * parameters.area * inventory.level[t]",
          "determines": "inventory.enthalpy[t]"
        },
        "mass_balance": {
          "for_each": {
            "t": "time"
          },
          "lhs": "rates.mass[t]",
          "rhs": "inlet.flow[t] - outlet.flow[t]",
          "determines": "rates.mass[t]"
        },
        "energy_balance": {
          "for_each": {
            "t": "time"
          },
          "lhs": "rates.energy[t]",
          "rhs": "inlet.flow[t] * inlet.enthalpy[t] - outlet.flow[t] * outlet.enthalpy[t] - loss.heat[t]",
          "determines": "rates.energy[t]"
        }
      },
      "derivatives": {
        "mass": {
          "state": "inventory.mass",
          "rate": "rates.mass",
          "with_respect_to": "time",
          "determines": "inventory.mass"
        },
        "energy": {
          "state": "inventory.energy",
          "rate": "rates.energy",
          "with_respect_to": "time",
          "determines": "inventory.energy"
        }
      },
      "models": {
        "inlet_state": {
          "model": "state_block",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "FluidProperties": {
              "model_parameter": "FluidProperties"
            }
          }
        },
        "contents_state": {
          "model": "state_block",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "FluidProperties": {
              "model_parameter": "FluidProperties"
            }
          }
        }
      },
      "connections": {
        "inlet_state": {
          "from": "inlet",
          "to": "inlet_state.state"
        }
      }
    }
  },
  "model_parameters": {
    "FluidProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa",
              "dimensions": [
                "time"
              ]
            },
            "enthalpy": {
              "unit": "J/kg",
              "dimensions": [
                "time"
              ]
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "density": {
              "unit": "kg/m**3",
              "dimensions": [
                "time"
              ]
            },
            "heat_capacity": {
              "unit": "J/kg/K",
              "dimensions": [
                "time"
              ]
            },
            "temperature": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            },
            "entropy": {
              "unit": "J/kg/K",
              "dimensions": [
                "time"
              ]
            },
            "vapor_fraction": {
              "unit": "dimensionless",
              "dimensions": [
                "time"
              ]
            },
            "temperature_bubble": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            },
            "temperature_dew": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            }
          }
        }
      }
    }
  }
}
