{
  "id": "valve",
  "description": "Scalar illustrative equations, not a numerical reproduction of the existing property-package models.",
  "structs": {
    "inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "pressure_drop": {
          "unit": "Pa"
        }
      }
    }
  },
  "relationships": {
    "isenthalpic": {
      "models": {},
      "constraints": {
        "mass_balance": {
          "lhs": "outlet.flow",
          "rhs": "inlet.flow",
          "determines": "outlet.flow"
        },
        "enthalpy_balance": {
          "lhs": "outlet.enthalpy",
          "rhs": "inlet.enthalpy",
          "determines": "outlet.enthalpy"
        },
        "pressure_balance": {
          "lhs": "outlet.pressure",
          "rhs": "inlet.pressure - parameters.pressure_drop",
          "determines": "outlet.pressure"
        }
      },
      "connections": {}
    }
  }
}
