{
  "id": "valve",
  "description": "Time-indexed illustrative equations, not a numerical reproduction of the existing property-package models.",
  "structs": {
    "inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "pressure_drop": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        }
      }
    }
  },
  "relationships": {
    "isenthalpic": {
      "models": {},
      "constraints": {
        "mass_balance": {
          "lhs": "outlet.flow[t]",
          "rhs": "inlet.flow[t]",
          "determines": "outlet.flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "enthalpy_balance": {
          "lhs": "outlet.enthalpy[t]",
          "rhs": "inlet.enthalpy[t]",
          "determines": "outlet.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "pressure_balance": {
          "lhs": "outlet.pressure[t]",
          "rhs": "inlet.pressure[t] - parameters.pressure_drop[t]",
          "determines": "outlet.pressure[t]",
          "for_each": {
            "t": "time"
          }
        }
      },
      "connections": {}
    }
  },
  "domains": {
    "time": {
      "kind": "time"
    }
  }
}
