{
  "id": "heat_pump",
  "description": "Time-indexed illustrative equations, not a numerical reproduction of the existing property-package models.",
  "structs": {
    "source_inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "source_outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "sink_inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "sink_outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "performance": {
      "direction": "output",
      "variables": {
        "heating_duty": {
          "unit": "W",
          "dimensions": [
            "time"
          ]
        },
        "cooling_duty": {
          "unit": "W",
          "dimensions": [
            "time"
          ]
        },
        "cop": {
          "unit": "dimensionless",
          "dimensions": [
            "time"
          ]
        },
        "electrical_power": {
          "unit": "W",
          "dimensions": [
            "time"
          ]
        }
      }
    }
  },
  "relationships": {
    "aggregate": {
      "models": {
        "cop_model": {
          "model": "prescribed_cop",
          "domain_bindings": {
            "time": "time"
          }
        },
        "source_inlet_state": {
          "model_parameter": "ColdSideProperties",
          "domain_bindings": {
            "time": "time"
          }
        },
        "source_outlet_state": {
          "model_parameter": "ColdSideProperties",
          "domain_bindings": {
            "time": "time"
          }
        },
        "sink_inlet_state": {
          "model_parameter": "HotSideProperties",
          "domain_bindings": {
            "time": "time"
          }
        },
        "sink_outlet_state": {
          "model_parameter": "HotSideProperties",
          "domain_bindings": {
            "time": "time"
          }
        },
        "power_model": {
          "model": "prescribed_power",
          "domain_bindings": {
            "time": "time"
          }
        }
      },
      "constraints": {
        "heating_duty_from_cop": {
          "lhs": "performance.heating_duty[t]",
          "rhs": "cop_model.performance.cop[t] * performance.electrical_power[t]",
          "determines": "performance.heating_duty[t]",
          "for_each": {
            "t": "time"
          }
        },
        "heat_balance": {
          "lhs": "performance.cooling_duty[t]",
          "rhs": "performance.heating_duty[t] - performance.electrical_power[t]",
          "determines": "performance.cooling_duty[t]",
          "for_each": {
            "t": "time"
          }
        },
        "source_mass_balance": {
          "lhs": "source_outlet.flow[t]",
          "rhs": "source_inlet.flow[t]",
          "determines": "source_outlet.flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "source_pressure_balance": {
          "lhs": "source_outlet.pressure[t]",
          "rhs": "source_inlet.pressure[t]",
          "determines": "source_outlet.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "source_heat_balance": {
          "lhs": "source_outlet.flow[t] * source_outlet.enthalpy[t]",
          "rhs": "source_inlet.flow[t] * source_inlet.enthalpy[t] - performance.cooling_duty[t]",
          "determines": "source_outlet.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "sink_mass_balance": {
          "lhs": "sink_outlet.flow[t]",
          "rhs": "sink_inlet.flow[t]",
          "determines": "sink_outlet.flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "sink_pressure_balance": {
          "lhs": "sink_outlet.pressure[t]",
          "rhs": "sink_inlet.pressure[t]",
          "determines": "sink_outlet.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "sink_heat_balance": {
          "lhs": "sink_outlet.flow[t] * sink_outlet.enthalpy[t]",
          "rhs": "sink_inlet.flow[t] * sink_inlet.enthalpy[t] + performance.heating_duty[t]",
          "determines": "sink_outlet.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "cop": {
          "lhs": "performance.cop[t]",
          "rhs": "cop_model.performance.cop[t]",
          "determines": "performance.cop[t]",
          "for_each": {
            "t": "time"
          }
        },
        "source_inlet_state_pressure": {
          "lhs": "source_inlet_state.state.pressure[t]",
          "rhs": "source_inlet.pressure[t]",
          "determines": "source_inlet_state.state.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "source_inlet_state_enthalpy": {
          "lhs": "source_inlet_state.state.enthalpy[t]",
          "rhs": "source_inlet.enthalpy[t]",
          "determines": "source_inlet_state.state.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "source_outlet_state_pressure": {
          "lhs": "source_outlet_state.state.pressure[t]",
          "rhs": "source_outlet.pressure[t]",
          "determines": "source_outlet_state.state.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "source_outlet_state_enthalpy": {
          "lhs": "source_outlet_state.state.enthalpy[t]",
          "rhs": "source_outlet.enthalpy[t]",
          "determines": "source_outlet_state.state.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "sink_inlet_state_pressure": {
          "lhs": "sink_inlet_state.state.pressure[t]",
          "rhs": "sink_inlet.pressure[t]",
          "determines": "sink_inlet_state.state.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "sink_inlet_state_enthalpy": {
          "lhs": "sink_inlet_state.state.enthalpy[t]",
          "rhs": "sink_inlet.enthalpy[t]",
          "determines": "sink_inlet_state.state.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "sink_outlet_state_pressure": {
          "lhs": "sink_outlet_state.state.pressure[t]",
          "rhs": "sink_outlet.pressure[t]",
          "determines": "sink_outlet_state.state.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "sink_outlet_state_enthalpy": {
          "lhs": "sink_outlet_state.state.enthalpy[t]",
          "rhs": "sink_outlet.enthalpy[t]",
          "determines": "sink_outlet_state.state.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "power": {
          "lhs": "performance.electrical_power[t]",
          "rhs": "power_model.performance.electrical_power[t]",
          "determines": "performance.electrical_power[t]",
          "for_each": {
            "t": "time"
          }
        }
      },
      "connections": {}
    },
    "cycle": {
      "models": {
        "compressor": {
          "model": "compressor",
          "model_arguments": {
            "FluidProperties": {
              "model_parameter": "RefrigerantProperties"
            },
            "IsentropicProperties": {
              "model_parameter": "IsentropicProperties"
            }
          },
          "domain_bindings": {
            "time": "time"
          }
        },
        "condenser": {
          "model": "heat_exchanger",
          "domain_bindings": {
            "time": "time"
          }
        },
        "subcooler": {
          "model": "heat_exchanger",
          "domain_bindings": {
            "time": "time"
          }
        },
        "ihx": {
          "model": "heat_exchanger",
          "domain_bindings": {
            "time": "time"
          }
        },
        "expansion_valve": {
          "model": "valve",
          "domain_bindings": {
            "time": "time"
          }
        },
        "evaporator": {
          "model": "heat_exchanger",
          "domain_bindings": {
            "time": "time"
          }
        },
        "source_inlet_state": {
          "model_parameter": "ColdSideProperties",
          "domain_bindings": {
            "time": "time"
          }
        },
        "source_outlet_state": {
          "model_parameter": "ColdSideProperties",
          "domain_bindings": {
            "time": "time"
          }
        },
        "sink_inlet_state": {
          "model_parameter": "HotSideProperties",
          "domain_bindings": {
            "time": "time"
          }
        },
        "sink_outlet_state": {
          "model_parameter": "HotSideProperties",
          "domain_bindings": {
            "time": "time"
          }
        }
      },
      "constraints": {
        "compressor_power_balance": {
          "lhs": "performance.electrical_power[t]",
          "rhs": "compressor.performance.work[t]",
          "determines": "performance.electrical_power[t]",
          "for_each": {
            "t": "time"
          }
        },
        "sink_heat_balance": {
          "lhs": "performance.heating_duty[t]",
          "rhs": "sink_outlet.flow[t] * sink_outlet.enthalpy[t] - sink_inlet.flow[t] * sink_inlet.enthalpy[t]",
          "determines": "performance.heating_duty[t]",
          "for_each": {
            "t": "time"
          }
        },
        "source_heat_balance": {
          "lhs": "performance.cooling_duty[t]",
          "rhs": "source_inlet.flow[t] * source_inlet.enthalpy[t] - source_outlet.flow[t] * source_outlet.enthalpy[t]",
          "determines": "performance.cooling_duty[t]",
          "for_each": {
            "t": "time"
          }
        },
        "cop": {
          "lhs": "performance.cop[t] * performance.electrical_power[t]",
          "rhs": "performance.heating_duty[t]",
          "determines": "performance.cop[t]",
          "for_each": {
            "t": "time"
          }
        },
        "source_inlet_state_pressure": {
          "lhs": "source_inlet_state.state.pressure[t]",
          "rhs": "source_inlet.pressure[t]",
          "determines": "source_inlet_state.state.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "source_inlet_state_enthalpy": {
          "lhs": "source_inlet_state.state.enthalpy[t]",
          "rhs": "source_inlet.enthalpy[t]",
          "determines": "source_inlet_state.state.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "source_outlet_state_pressure": {
          "lhs": "source_outlet_state.state.pressure[t]",
          "rhs": "source_outlet.pressure[t]",
          "determines": "source_outlet_state.state.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "source_outlet_state_enthalpy": {
          "lhs": "source_outlet_state.state.enthalpy[t]",
          "rhs": "source_outlet.enthalpy[t]",
          "determines": "source_outlet_state.state.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "sink_inlet_state_pressure": {
          "lhs": "sink_inlet_state.state.pressure[t]",
          "rhs": "sink_inlet.pressure[t]",
          "determines": "sink_inlet_state.state.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "sink_inlet_state_enthalpy": {
          "lhs": "sink_inlet_state.state.enthalpy[t]",
          "rhs": "sink_inlet.enthalpy[t]",
          "determines": "sink_inlet_state.state.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "sink_outlet_state_pressure": {
          "lhs": "sink_outlet_state.state.pressure[t]",
          "rhs": "sink_outlet.pressure[t]",
          "determines": "sink_outlet_state.state.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "sink_outlet_state_enthalpy": {
          "lhs": "sink_outlet_state.state.enthalpy[t]",
          "rhs": "sink_outlet.enthalpy[t]",
          "determines": "sink_outlet_state.state.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        }
      },
      "connections": {
        "link_1": {
          "from": "compressor.outlet",
          "to": "condenser.hot_inlet"
        },
        "link_2": {
          "from": "condenser.hot_outlet",
          "to": "subcooler.hot_inlet"
        },
        "link_3": {
          "from": "subcooler.hot_outlet",
          "to": "ihx.hot_inlet"
        },
        "link_4": {
          "from": "ihx.hot_outlet",
          "to": "expansion_valve.inlet"
        },
        "link_5": {
          "from": "expansion_valve.outlet",
          "to": "evaporator.cold_inlet"
        },
        "link_6": {
          "from": "evaporator.cold_outlet",
          "to": "ihx.cold_inlet"
        },
        "link_7": {
          "from": "ihx.cold_outlet",
          "to": "compressor.inlet"
        },
        "link_8": {
          "from": "source_inlet",
          "to": "evaporator.hot_inlet"
        },
        "link_9": {
          "from": "evaporator.hot_outlet",
          "to": "source_outlet"
        },
        "link_10": {
          "from": "sink_inlet",
          "to": "subcooler.cold_inlet"
        },
        "link_11": {
          "from": "subcooler.cold_outlet",
          "to": "condenser.cold_inlet"
        },
        "link_12": {
          "from": "condenser.cold_outlet",
          "to": "sink_outlet"
        }
      }
    }
  },
  "model_parameters": {
    "HotSideProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa",
              "dimensions": [
                "time"
              ]
            },
            "enthalpy": {
              "unit": "J/kg",
              "dimensions": [
                "time"
              ]
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "temperature": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            }
          }
        }
      }
    },
    "ColdSideProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa",
              "dimensions": [
                "time"
              ]
            },
            "enthalpy": {
              "unit": "J/kg",
              "dimensions": [
                "time"
              ]
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "temperature": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            }
          }
        }
      }
    },
    "RefrigerantProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa",
              "dimensions": [
                "time"
              ]
            },
            "enthalpy": {
              "unit": "J/kg",
              "dimensions": [
                "time"
              ]
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "entropy": {
              "unit": "J/kg/K",
              "dimensions": [
                "time"
              ]
            }
          }
        }
      }
    },
    "IsentropicProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa",
              "dimensions": [
                "time"
              ]
            },
            "entropy": {
              "unit": "J/kg/K",
              "dimensions": [
                "time"
              ]
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "enthalpy": {
              "unit": "J/kg",
              "dimensions": [
                "time"
              ]
            }
          }
        }
      }
    }
  },
  "domains": {
    "time": {
      "kind": "time"
    }
  }
}
