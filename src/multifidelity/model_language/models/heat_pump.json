{
  "id": "heat_pump",
  "description": "Scalar illustrative equations, not a numerical reproduction of the existing property-package models.",
  "structs": {
    "source_inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "source_outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "sink_inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "sink_outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "performance": {
      "direction": "output",
      "variables": {
        "heating_duty": {
          "unit": "W"
        },
        "cooling_duty": {
          "unit": "W"
        },
        "cop": {
          "unit": "dimensionless"
        },
        "electrical_power": {
          "unit": "W"
        }
      }
    }
  },
  "relationships": {
    "aggregate": {
      "models": {
        "cop_model": {
          "model": "prescribed_cop"
        },
        "source_inlet_state": {
          "model_parameter": "ColdSideProperties"
        },
        "source_outlet_state": {
          "model_parameter": "ColdSideProperties"
        },
        "sink_inlet_state": {
          "model_parameter": "HotSideProperties"
        },
        "sink_outlet_state": {
          "model_parameter": "HotSideProperties"
        },
        "power_model": {
          "model": "prescribed_power"
        }
      },
      "constraints": {
        "heating_duty_from_cop": {
          "lhs": "performance.heating_duty",
          "rhs": "cop_model.performance.cop * performance.electrical_power",
          "determines": "performance.heating_duty"
        },
        "heat_balance": {
          "lhs": "performance.cooling_duty",
          "rhs": "performance.heating_duty - performance.electrical_power",
          "determines": "performance.cooling_duty"
        },
        "source_mass_balance": {
          "lhs": "source_outlet.flow",
          "rhs": "source_inlet.flow",
          "determines": "source_outlet.flow"
        },
        "source_pressure_balance": {
          "lhs": "source_outlet.pressure",
          "rhs": "source_inlet.pressure",
          "determines": "source_outlet.pressure"
        },
        "source_heat_balance": {
          "lhs": "source_outlet.flow * source_outlet.enthalpy",
          "rhs": "source_inlet.flow * source_inlet.enthalpy - performance.cooling_duty",
          "determines": "source_outlet.enthalpy"
        },
        "sink_mass_balance": {
          "lhs": "sink_outlet.flow",
          "rhs": "sink_inlet.flow",
          "determines": "sink_outlet.flow"
        },
        "sink_pressure_balance": {
          "lhs": "sink_outlet.pressure",
          "rhs": "sink_inlet.pressure",
          "determines": "sink_outlet.pressure"
        },
        "sink_heat_balance": {
          "lhs": "sink_outlet.flow * sink_outlet.enthalpy",
          "rhs": "sink_inlet.flow * sink_inlet.enthalpy + performance.heating_duty",
          "determines": "sink_outlet.enthalpy"
        },
        "cop": {
          "lhs": "performance.cop",
          "rhs": "cop_model.performance.cop",
          "determines": "performance.cop"
        },
        "source_inlet_state_pressure": {
          "lhs": "source_inlet_state.state.pressure",
          "rhs": "source_inlet.pressure",
          "determines": "source_inlet_state.state.pressure"
        },
        "source_inlet_state_enthalpy": {
          "lhs": "source_inlet_state.state.enthalpy",
          "rhs": "source_inlet.enthalpy",
          "determines": "source_inlet_state.state.enthalpy"
        },
        "source_outlet_state_pressure": {
          "lhs": "source_outlet_state.state.pressure",
          "rhs": "source_outlet.pressure",
          "determines": "source_outlet_state.state.pressure"
        },
        "source_outlet_state_enthalpy": {
          "lhs": "source_outlet_state.state.enthalpy",
          "rhs": "source_outlet.enthalpy",
          "determines": "source_outlet_state.state.enthalpy"
        },
        "sink_inlet_state_pressure": {
          "lhs": "sink_inlet_state.state.pressure",
          "rhs": "sink_inlet.pressure",
          "determines": "sink_inlet_state.state.pressure"
        },
        "sink_inlet_state_enthalpy": {
          "lhs": "sink_inlet_state.state.enthalpy",
          "rhs": "sink_inlet.enthalpy",
          "determines": "sink_inlet_state.state.enthalpy"
        },
        "sink_outlet_state_pressure": {
          "lhs": "sink_outlet_state.state.pressure",
          "rhs": "sink_outlet.pressure",
          "determines": "sink_outlet_state.state.pressure"
        },
        "sink_outlet_state_enthalpy": {
          "lhs": "sink_outlet_state.state.enthalpy",
          "rhs": "sink_outlet.enthalpy",
          "determines": "sink_outlet_state.state.enthalpy"
        },
        "power": {
          "lhs": "performance.electrical_power",
          "rhs": "power_model.performance.electrical_power",
          "determines": "performance.electrical_power"
        }
      },
      "connections": {}
    },
    "cycle": {
      "models": {
        "compressor": {
          "model": "compressor",
          "model_arguments": {
            "FluidProperties": {
              "model_parameter": "RefrigerantProperties"
            },
            "IsentropicProperties": {
              "model_parameter": "IsentropicProperties"
            }
          }
        },
        "condenser": {
          "model": "heat_exchanger"
        },
        "subcooler": {
          "model": "heat_exchanger"
        },
        "ihx": {
          "model": "heat_exchanger"
        },
        "expansion_valve": {
          "model": "valve"
        },
        "evaporator": {
          "model": "heat_exchanger"
        },
        "source_inlet_state": {
          "model_parameter": "ColdSideProperties"
        },
        "source_outlet_state": {
          "model_parameter": "ColdSideProperties"
        },
        "sink_inlet_state": {
          "model_parameter": "HotSideProperties"
        },
        "sink_outlet_state": {
          "model_parameter": "HotSideProperties"
        }
      },
      "constraints": {
        "compressor_power_balance": {
          "lhs": "performance.electrical_power",
          "rhs": "compressor.performance.work",
          "determines": "performance.electrical_power"
        },
        "sink_heat_balance": {
          "lhs": "performance.heating_duty",
          "rhs": "sink_outlet.flow * sink_outlet.enthalpy - sink_inlet.flow * sink_inlet.enthalpy",
          "determines": "performance.heating_duty"
        },
        "source_heat_balance": {
          "lhs": "performance.cooling_duty",
          "rhs": "source_inlet.flow * source_inlet.enthalpy - source_outlet.flow * source_outlet.enthalpy",
          "determines": "performance.cooling_duty"
        },
        "cop": {
          "lhs": "performance.cop * performance.electrical_power",
          "rhs": "performance.heating_duty",
          "determines": "performance.cop"
        },
        "source_inlet_state_pressure": {
          "lhs": "source_inlet_state.state.pressure",
          "rhs": "source_inlet.pressure",
          "determines": "source_inlet_state.state.pressure"
        },
        "source_inlet_state_enthalpy": {
          "lhs": "source_inlet_state.state.enthalpy",
          "rhs": "source_inlet.enthalpy",
          "determines": "source_inlet_state.state.enthalpy"
        },
        "source_outlet_state_pressure": {
          "lhs": "source_outlet_state.state.pressure",
          "rhs": "source_outlet.pressure",
          "determines": "source_outlet_state.state.pressure"
        },
        "source_outlet_state_enthalpy": {
          "lhs": "source_outlet_state.state.enthalpy",
          "rhs": "source_outlet.enthalpy",
          "determines": "source_outlet_state.state.enthalpy"
        },
        "sink_inlet_state_pressure": {
          "lhs": "sink_inlet_state.state.pressure",
          "rhs": "sink_inlet.pressure",
          "determines": "sink_inlet_state.state.pressure"
        },
        "sink_inlet_state_enthalpy": {
          "lhs": "sink_inlet_state.state.enthalpy",
          "rhs": "sink_inlet.enthalpy",
          "determines": "sink_inlet_state.state.enthalpy"
        },
        "sink_outlet_state_pressure": {
          "lhs": "sink_outlet_state.state.pressure",
          "rhs": "sink_outlet.pressure",
          "determines": "sink_outlet_state.state.pressure"
        },
        "sink_outlet_state_enthalpy": {
          "lhs": "sink_outlet_state.state.enthalpy",
          "rhs": "sink_outlet.enthalpy",
          "determines": "sink_outlet_state.state.enthalpy"
        }
      },
      "connections": {
        "link_1": {
          "from": "compressor.outlet",
          "to": "condenser.hot_inlet"
        },
        "link_2": {
          "from": "condenser.hot_outlet",
          "to": "subcooler.hot_inlet"
        },
        "link_3": {
          "from": "subcooler.hot_outlet",
          "to": "ihx.hot_inlet"
        },
        "link_4": {
          "from": "ihx.hot_outlet",
          "to": "expansion_valve.inlet"
        },
        "link_5": {
          "from": "expansion_valve.outlet",
          "to": "evaporator.cold_inlet"
        },
        "link_6": {
          "from": "evaporator.cold_outlet",
          "to": "ihx.cold_inlet"
        },
        "link_7": {
          "from": "ihx.cold_outlet",
          "to": "compressor.inlet"
        },
        "link_8": {
          "from": "source_inlet",
          "to": "evaporator.hot_inlet"
        },
        "link_9": {
          "from": "evaporator.hot_outlet",
          "to": "source_outlet"
        },
        "link_10": {
          "from": "sink_inlet",
          "to": "subcooler.cold_inlet"
        },
        "link_11": {
          "from": "subcooler.cold_outlet",
          "to": "condenser.cold_inlet"
        },
        "link_12": {
          "from": "condenser.cold_outlet",
          "to": "sink_outlet"
        }
      }
    }
  },
  "model_parameters": {
    "HotSideProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa"
            },
            "enthalpy": {
              "unit": "J/kg"
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "temperature": {
              "unit": "K"
            }
          }
        }
      }
    },
    "ColdSideProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa"
            },
            "enthalpy": {
              "unit": "J/kg"
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "temperature": {
              "unit": "K"
            }
          }
        }
      }
    },
    "RefrigerantProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa"
            },
            "enthalpy": {
              "unit": "J/kg"
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "entropy": {
              "unit": "J/kg/K"
            }
          }
        }
      }
    },
    "IsentropicProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa"
            },
            "entropy": {
              "unit": "J/kg/K"
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "enthalpy": {
              "unit": "J/kg"
            }
          }
        }
      }
    }
  }
}
