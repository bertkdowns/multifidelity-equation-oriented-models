{
  "id": "mixer",
  "description": "Time-indexed illustrative equations, not a numerical reproduction of the existing property-package models.",
  "structs": {
    "main": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1,
          "default": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 200000
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 100000
        }
      }
    },
    "makeup": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1,
          "default": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 200000
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 100000
        }
      }
    },
    "outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1,
          "default": 2
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 200000
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 100000
        }
      }
    }
  },
  "relationships": {
    "balance": {
      "models": {},
      "constraints": {
        "mass_balance": {
          "lhs": "outlet.flow[t]",
          "rhs": "main.flow[t] + makeup.flow[t]",
          "determines": "outlet.flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "energy_balance": {
          "lhs": "outlet.flow[t] * outlet.enthalpy[t]",
          "rhs": "main.flow[t] * main.enthalpy[t] + makeup.flow[t] * makeup.enthalpy[t]",
          "determines": "outlet.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "pressure_balance": {
          "lhs": "outlet.pressure[t]",
          "rhs": "main.pressure[t]",
          "determines": "outlet.pressure[t]",
          "for_each": {
            "t": "time"
          }
        }
      },
      "connections": {}
    }
  },
  "domains": {
    "time": {
      "kind": "time"
    }
  }
}
