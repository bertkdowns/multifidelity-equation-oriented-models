{
  "id": "mixer",
  "description": "Scalar illustrative equations, not a numerical reproduction of the existing property-package models.",
  "structs": {
    "main": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "makeup": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    }
  },
  "relationships": {
    "balance": {
      "models": {},
      "constraints": {
        "mass_balance": {
          "lhs": "outlet.flow",
          "rhs": "main.flow + makeup.flow",
          "determines": "outlet.flow"
        },
        "energy_balance": {
          "lhs": "outlet.flow * outlet.enthalpy",
          "rhs": "main.flow * main.enthalpy + makeup.flow * makeup.enthalpy",
          "determines": "outlet.enthalpy"
        },
        "pressure_balance": {
          "lhs": "outlet.pressure",
          "rhs": "main.pressure",
          "determines": "outlet.pressure"
        }
      },
      "connections": {}
    }
  }
}
