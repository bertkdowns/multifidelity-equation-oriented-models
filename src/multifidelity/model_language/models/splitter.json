{
  "id": "splitter",
  "description": "Topology scaffold: prescribed flow split; no phase equilibrium or composition closure.",
  "structs": {
    "inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "main": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "branch": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "fraction": {
          "unit": "dimensionless",
          "bounds": {
            "min": 0,
            "max": 1
          }
        }
      }
    }
  },
  "relationships": {
    "split": {
      "models": {},
      "constraints": {
        "main_flow_split": {
          "lhs": "main.flow",
          "rhs": "inlet.flow * parameters.fraction",
          "determines": "main.flow"
        },
        "branch_mass_balance": {
          "lhs": "branch.flow",
          "rhs": "inlet.flow - main.flow",
          "determines": "branch.flow"
        },
        "main_pressure_balance": {
          "lhs": "main.pressure",
          "rhs": "inlet.pressure",
          "determines": "main.pressure"
        },
        "main_enthalpy_balance": {
          "lhs": "main.enthalpy",
          "rhs": "inlet.enthalpy",
          "determines": "main.enthalpy"
        },
        "branch_pressure_balance": {
          "lhs": "branch.pressure",
          "rhs": "inlet.pressure",
          "determines": "branch.pressure"
        },
        "branch_enthalpy_balance": {
          "lhs": "branch.enthalpy",
          "rhs": "inlet.enthalpy",
          "determines": "branch.enthalpy"
        }
      },
      "connections": {}
    }
  }
}
