{
  "id": "heat_exchanger",
  "description": "Time-indexed illustrative equations, not a numerical reproduction of the existing property-package models.",
  "structs": {
    "hot_inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "hot_outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "cold_inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "cold_outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "conductance": {
          "unit": "W/K"
        },
        "temperature_difference": {
          "unit": "K",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "performance": {
      "direction": "output",
      "variables": {
        "heat_duty": {
          "unit": "W",
          "dimensions": [
            "time"
          ]
        }
      }
    }
  },
  "relationships": {
    "lumped": {
      "models": {},
      "constraints": {
        "hot_mass_balance": {
          "lhs": "hot_outlet.flow[t]",
          "rhs": "hot_inlet.flow[t]",
          "determines": "hot_outlet.flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "hot_pressure_balance": {
          "lhs": "hot_outlet.pressure[t]",
          "rhs": "hot_inlet.pressure[t]",
          "determines": "hot_outlet.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "hot_heat_balance": {
          "lhs": "hot_outlet.flow[t] * hot_outlet.enthalpy[t]",
          "rhs": "hot_inlet.flow[t] * hot_inlet.enthalpy[t] - performance.heat_duty[t]",
          "determines": "hot_outlet.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "cold_mass_balance": {
          "lhs": "cold_outlet.flow[t]",
          "rhs": "cold_inlet.flow[t]",
          "determines": "cold_outlet.flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "cold_pressure_balance": {
          "lhs": "cold_outlet.pressure[t]",
          "rhs": "cold_inlet.pressure[t]",
          "determines": "cold_outlet.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "cold_heat_balance": {
          "lhs": "cold_outlet.flow[t] * cold_outlet.enthalpy[t]",
          "rhs": "cold_inlet.flow[t] * cold_inlet.enthalpy[t] + performance.heat_duty[t]",
          "determines": "cold_outlet.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "heat_transfer": {
          "lhs": "performance.heat_duty[t]",
          "rhs": "parameters.conductance * parameters.temperature_difference[t]",
          "determines": "performance.heat_duty[t]",
          "for_each": {
            "t": "time"
          }
        }
      },
      "connections": {}
    }
  },
  "domains": {
    "time": {
      "kind": "time"
    }
  }
}
