{
  "id": "heat_exchanger",
  "description": "Scalar illustrative equations, not a numerical reproduction of the existing property-package models.",
  "structs": {
    "hot_inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "hot_outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "cold_inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "cold_outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "conductance": {
          "unit": "W/K"
        },
        "temperature_difference": {
          "unit": "K"
        }
      }
    },
    "performance": {
      "direction": "output",
      "variables": {
        "heat_duty": {
          "unit": "W"
        }
      }
    }
  },
  "relationships": {
    "lumped": {
      "models": {},
      "constraints": {
        "eq_1": {
          "lhs": "hot_outlet.flow",
          "rhs": "hot_inlet.flow",
          "determines": "hot_outlet.flow"
        },
        "eq_2": {
          "lhs": "hot_outlet.pressure",
          "rhs": "hot_inlet.pressure",
          "determines": "hot_outlet.pressure"
        },
        "eq_3": {
          "lhs": "hot_outlet.flow * hot_outlet.enthalpy",
          "rhs": "hot_inlet.flow * hot_inlet.enthalpy - performance.heat_duty",
          "determines": "hot_outlet.enthalpy"
        },
        "eq_4": {
          "lhs": "cold_outlet.flow",
          "rhs": "cold_inlet.flow",
          "determines": "cold_outlet.flow"
        },
        "eq_5": {
          "lhs": "cold_outlet.pressure",
          "rhs": "cold_inlet.pressure",
          "determines": "cold_outlet.pressure"
        },
        "eq_6": {
          "lhs": "cold_outlet.flow * cold_outlet.enthalpy",
          "rhs": "cold_inlet.flow * cold_inlet.enthalpy + performance.heat_duty",
          "determines": "cold_outlet.enthalpy"
        },
        "eq_7": {
          "lhs": "performance.heat_duty",
          "rhs": "parameters.conductance * parameters.temperature_difference",
          "determines": "performance.heat_duty"
        }
      },
      "connections": {}
    }
  }
}
