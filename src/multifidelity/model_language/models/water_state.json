{
  "id": "water_state",
  "description": "Constant-property liquid-water approximation with affine mass-specific enthalpy. Coefficients are explicit caller-supplied inputs; no phase equilibrium or transport correlations. Liquid-only vapor fraction is zero. Saturation temperatures use IAPWS-IF97 region 4, Eq31/Table34, valid for 611.213 Pa to 22.064 MPa; this does not add two-phase thermodynamics.",
  "structs": {
    "state": {
      "direction": "input",
      "variables": {
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "bounds": {
            "min": 611.213,
            "max": 22064000
          }
        },
        "temperature": {
          "unit": "K",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "reference_pressure": {
          "unit": "Pa"
        },
        "reference_temperature": {
          "unit": "K"
        },
        "reference_enthalpy": {
          "unit": "J/kg"
        },
        "heat_capacity": {
          "unit": "J/kg/K"
        },
        "density": {
          "unit": "kg/m**3"
        },
        "viscosity": {
          "unit": "Pa*s"
        },
        "reference_entropy": {
          "unit": "J/kg/K"
        },
        "thermal_expansion": {
          "unit": "1/K"
        }
      }
    },
    "properties": {
      "direction": "output",
      "variables": {
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        },
        "density": {
          "unit": "kg/m**3",
          "dimensions": [
            "time"
          ]
        },
        "heat_capacity": {
          "unit": "J/kg/K",
          "dimensions": [
            "time"
          ]
        },
        "viscosity": {
          "unit": "Pa*s",
          "dimensions": [
            "time"
          ]
        },
        "entropy": {
          "unit": "J/kg/K",
          "dimensions": [
            "time"
          ]
        },
        "vapor_fraction": {
          "unit": "dimensionless",
          "dimensions": [
            "time"
          ]
        },
        "temperature_bubble": {
          "unit": "K",
          "dimensions": [
            "time"
          ]
        },
        "temperature_dew": {
          "unit": "K",
          "dimensions": [
            "time"
          ]
        }
      }
    }
  },
  "relationships": {
    "constant_properties": {
      "models": {},
      "constraints": {
        "enthalpy": {
          "lhs": "properties.enthalpy[t]",
          "rhs": "parameters.reference_enthalpy + parameters.heat_capacity * (state.temperature[t] - parameters.reference_temperature) + (state.pressure[t] - parameters.reference_pressure) / parameters.density",
          "determines": "properties.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "density": {
          "lhs": "properties.density[t]",
          "rhs": "parameters.density",
          "determines": "properties.density[t]",
          "for_each": {
            "t": "time"
          }
        },
        "heat_capacity": {
          "lhs": "properties.heat_capacity[t]",
          "rhs": "parameters.heat_capacity",
          "determines": "properties.heat_capacity[t]",
          "for_each": {
            "t": "time"
          }
        },
        "viscosity": {
          "lhs": "properties.viscosity[t]",
          "rhs": "parameters.viscosity",
          "determines": "properties.viscosity[t]",
          "for_each": {
            "t": "time"
          }
        },
        "entropy": {
          "lhs": "properties.entropy[t]",
          "rhs": "parameters.reference_entropy + parameters.heat_capacity / parameters.reference_temperature * (state.temperature[t] - parameters.reference_temperature) - parameters.thermal_expansion / parameters.density * (state.pressure[t] - parameters.reference_pressure)",
          "determines": "properties.entropy[t]",
          "for_each": {
            "t": "time"
          }
        },
