{
  "id": "helmholtz_isobutane_ph",
  "description": "Mass-basis isobutane (R600a) Helmholtz PH state using Ahuora EOS data.",
  "structs": {
    "state": {
      "direction": "input",
      "variables": {
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "default": 500000,
          "scale": 1e-05
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "default": 400000,
          "scale": 1e-05
        }
      }
    },
    "properties": {
      "direction": "output",
      "variables": {
        "density": {
          "unit": "kg/m**3",
          "dimensions": [
            "time"
          ],
          "default": 20,
          "scale": 0.001
        },
        "heat_capacity": {
          "unit": "J/kg/K",
          "dimensions": [
            "time"
          ],
          "default": 1700,
          "scale": 0.001
        },
        "temperature": {
          "unit": "K",
          "dimensions": [
            "time"
          ],
          "default": 300,
          "scale": 0.0033333333333333335
        },
        "entropy": {
          "unit": "J/kg/K",
          "dimensions": [
            "time"
          ],
          "default": 1000,
          "scale": 0.001
        },
        "vapor_fraction": {
          "unit": "dimensionless",
          "dimensions": [
            "time"
          ],
          "default": 0,
          "scale": 1
        },
        "temperature_bubble": {
          "unit": "K",
          "dimensions": [
            "time"
          ],
          "default": 300,
          "scale": 0.0033333333333333335
        },
        "temperature_dew": {
          "unit": "K",
          "dimensions": [
            "time"
          ],
          "default": 300,
          "scale": 0.0033333333333333335
        },
        "enthalpy_liquid_sat": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "default": 200000,
          "scale": 1e-05
        },
        "enthalpy_vapor_sat": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "default": 600000,
          "scale": 1e-05
        },
        "enthalpy_liquid": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "default": 200000,
          "scale": 1e-05
        },
        "enthalpy_vapor": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "default": 600000,
          "scale": 1e-05
        }
      }
    }
  },
  "relationships": {
    "helmholtz": {
      "external": {
        "provider": "standard.helmholtz_ph",
        "config": {
          "fluid": "i-butane",
          "include_viscosity": false
        },
        "dependencies": {
          "properties.density": [
            "state.pressure",
            "state.enthalpy"
          ],
          "properties.heat_capacity": [
            "state.pressure",
            "state.enthalpy"
          ],
          "properties.temperature": [
            "state.pressure",
            "state.enthalpy"
          ],
          "properties.entropy": [
            "state.pressure",
            "state.enthalpy"
          ],
          "properties.vapor_fraction": [
            "state.pressure",
            "state.enthalpy"
          ],
          "properties.temperature_bubble": [
            "state.pressure"
          ],
          "properties.temperature_dew": [
            "state.pressure"
          ],
          "properties.enthalpy_liquid_sat": [
            "state.pressure"
          ],
          "properties.enthalpy_vapor_sat": [
            "state.pressure"
          ],
          "properties.enthalpy_liquid": [
            "state.pressure",
            "state.enthalpy"
          ],
          "properties.enthalpy_vapor": [
            "state.pressure",
            "state.enthalpy"
          ]
        }
      }
    }
