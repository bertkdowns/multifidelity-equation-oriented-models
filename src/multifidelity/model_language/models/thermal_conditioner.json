{
  "id": "thermal_conditioner",
  "description": "Time-indexed illustrative equations, not a numerical reproduction of the existing property-package models.",
  "structs": {
    "inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "default": 1,
          "scale": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "default": 100000,
          "scale": 1e-05
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "default": 10000,
          "scale": 1e-05
        }
      }
    },
    "outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "default": 1,
          "scale": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "default": 100000,
          "scale": 1e-05
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "default": 10000,
          "scale": 1e-05
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "heat_duty": {
          "unit": "W",
          "dimensions": [
            "time"
          ],
          "default": 0,
          "scale": 0.0001
        }
      }
    }
  },
  "relationships": {
    "energy_balance": {
      "models": {},
      "constraints": {
        "mass_balance": {
          "lhs": "outlet.flow[t]",
          "rhs": "inlet.flow[t]",
          "determines": "outlet.flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "pressure_balance": {
          "lhs": "outlet.pressure[t]",
          "rhs": "inlet.pressure[t]",
          "determines": "outlet.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "heat_balance": {
          "lhs": "outlet.flow[t] * outlet.enthalpy[t]",
          "rhs": "inlet.flow[t] * inlet.enthalpy[t] + parameters.heat_duty[t]",
          "determines": "outlet.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        }
      },
      "connections": {}
    }
  },
  "domains": {
    "time": {
      "kind": "time"
    }
  }
}
