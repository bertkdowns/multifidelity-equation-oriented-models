{
  "id": "compressor",
  "description": "Efficiency-based steady pressure changer using property-model arguments; adiabatic energy balance, no kinetic or potential energy changes.",
  "model_parameters": {
    "FluidProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa",
              "dimensions": [
                "time"
              ]
            },
            "enthalpy": {
              "unit": "J/kg",
              "dimensions": [
                "time"
              ]
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "entropy": {
              "unit": "J/kg/K",
              "dimensions": [
                "time"
              ]
            }
          }
        }
      }
    },
    "IsentropicProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa",
              "dimensions": [
                "time"
              ]
            },
            "entropy": {
              "unit": "J/kg/K",
              "dimensions": [
                "time"
              ]
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "enthalpy": {
              "unit": "J/kg",
              "dimensions": [
                "time"
              ]
            }
          }
        }
      }
    }
  },
  "structs": {
    "inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "pressure_rise": {
          "unit": "Pa",
          "bounds": {
            "min": 0
          },
          "dimensions": [
            "time"
          ]
        },
        "efficiency": {
          "unit": "dimensionless",
          "bounds": {
            "min": 1e-06,
            "max": 1
          },
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "performance": {
      "direction": "output",
      "variables": {
        "work": {
          "unit": "W",
          "bounds": {
            "min": 0
          },
          "dimensions": [
            "time"
          ]
        },
        "isentropic_work": {
          "unit": "W",
          "dimensions": [
            "time"
          ]
        }
      }
    }
  },
  "relationships": {
    "isentropic": {
      "models": {
        "inlet_state": {
          "model_parameter": "FluidProperties",
          "domain_bindings": {
            "time": "time"
          }
        },
        "outlet_state": {
          "model_parameter": "FluidProperties",
          "domain_bindings": {
            "time": "time"
          }
        },
        "isentropic_state": {
          "model_parameter": "IsentropicProperties",
          "domain_bindings": {
            "time": "time"
          }
        }
      },
      "constraints": {
        "mass_balance": {
          "lhs": "outlet.flow[t]",
          "rhs": "inlet.flow[t]",
          "determines": "outlet.flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "pressure": {
          "lhs": "outlet.pressure[t]",
          "rhs": "inlet.pressure[t] + parameters.pressure_rise[t]",
          "determines": "outlet.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "energy_balance": {
          "lhs": "outlet.flow[t] * outlet.enthalpy[t]",
          "rhs": "inlet.flow[t] * inlet.enthalpy[t] + performance.work[t]",
          "determines": "outlet.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "inlet_pressure": {
          "lhs": "inlet_state.state.pressure[t]",
          "rhs": "inlet.pressure[t]",
          "determines": "inlet_state.state.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "inlet_enthalpy": {
          "lhs": "inlet_state.state.enthalpy[t]",
          "rhs": "inlet.enthalpy[t]",
          "determines": "inlet_state.state.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "outlet_pressure": {
          "lhs": "outlet_state.state.pressure[t]",
          "rhs": "outlet.pressure[t]",
          "determines": "outlet_state.state.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "outlet_enthalpy": {
          "lhs": "outlet_state.state.enthalpy[t]",
          "rhs": "outlet.enthalpy[t]",
          "determines": "outlet_state.state.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "isentropic_pressure": {
          "lhs": "isentropic_state.state.pressure[t]",
          "rhs": "outlet.pressure[t]",
          "determines": "isentropic_state.state.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "isentropic_entropy": {
          "lhs": "isentropic_state.state.entropy[t]",
          "rhs": "inlet_state.properties.entropy[t]",
          "determines": "isentropic_state.state.entropy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "isentropic_work": {
          "lhs": "performance.isentropic_work[t]",
          "rhs": "inlet.flow[t] * (isentropic_state.properties.enthalpy[t] - inlet.enthalpy[t])",
          "determines": "performance.isentropic_work[t]",
          "for_each": {
            "t": "time"
          }
        },
        "efficiency": {
          "lhs": "parameters.efficiency[t] * performance.work[t]",
          "rhs": "performance.isentropic_work[t]",
          "determines": "performance.work[t]",
          "for_each": {
            "t": "time"
          }
        }
      },
      "connections": {}
    }
  },
  "domains": {
    "time": {
      "kind": "time"
    }
  }
}
