{
  "id": "state_block",
  "description": "A single stream state with flow, pressure and enthalpy, and thermodynamic properties from a configured package.",
  "model_parameters": {
    "FluidProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa",
              "dimensions": [
                "time"
              ]
            },
            "enthalpy": {
              "unit": "J/kg",
              "dimensions": [
                "time"
              ]
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "density": {
              "unit": "kg/m**3",
              "dimensions": [
                "time"
              ]
            },
            "heat_capacity": {
              "unit": "J/kg/K",
              "dimensions": [
                "time"
              ]
            },
            "temperature": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            },
            "entropy": {
              "unit": "J/kg/K",
              "dimensions": [
                "time"
              ]
            },
            "vapor_fraction": {
              "unit": "dimensionless",
              "dimensions": [
                "time"
              ]
            },
            "temperature_bubble": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            },
            "temperature_dew": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            }
          }
        }
      }
    }
  },
  "structs": {
    "state": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "default": 1,
          "scale": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "default": 200000,
          "scale": 1e-05
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "default": 100000,
          "scale": 1e-05
        }
      }
    },
    "properties": {
      "direction": "output",
      "variables": {
        "density": {
          "unit": "kg/m**3",
          "dimensions": [
            "time"
          ],
          "default": 997.3928615808287,
          "scale": 0.001
        },
        "heat_capacity": {
          "unit": "J/kg/K",
          "dimensions": [
            "time"
          ],
          "default": 4200,
          "scale": 0.001
        },
        "temperature": {
          "unit": "K",
          "dimensions": [
            "time"
          ],
          "default": 296.953248576622,
          "scale": 0.0033333333333333335
        },
        "entropy": {
          "unit": "J/kg/K",
          "dimensions": [
            "time"
          ],
          "default": 1000,
          "scale": 0.001
        },
        "vapor_fraction": {
          "unit": "dimensionless",
          "dimensions": [
            "time"
          ],
          "default": 0,
          "scale": 1
        },
        "temperature_bubble": {
          "unit": "K",
          "dimensions": [
            "time"
          ],
          "default": 373.15,
          "scale": 0.0033333333333333335
        },
        "temperature_dew": {
          "unit": "K",
          "dimensions": [
            "time"
          ],
          "default": 373.15,
          "scale": 0.0033333333333333335
        }
      }
    }
  },
  "relationships": {
    "evaluate": {
      "models": {
        "fluid": {
          "model_parameter": "FluidProperties",
          "domain_bindings": {
            "time": "time"
          }
        }
      },
      "constraints": {
        "density": {
          "lhs": "properties.density[t]",
          "rhs": "fluid.properties.density[t]",
          "determines": "properties.density[t]",
          "for_each": {
            "t": "time"
          }
        },
        "heat_capacity": {
          "lhs": "properties.heat_capacity[t]",
          "rhs": "fluid.properties.heat_capacity[t]",
          "determines": "properties.heat_capacity[t]",
          "for_each": {
            "t": "time"
          }
        },
        "temperature": {
          "lhs": "properties.temperature[t]",
          "rhs": "fluid.properties.temperature[t]",
          "determines": "properties.temperature[t]",
          "for_each": {
            "t": "time"
          }
        },
        "entropy": {
          "lhs": "properties.entropy[t]",
          "rhs": "fluid.properties.entropy[t]",
          "determines": "properties.entropy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "pressure": {
          "for_each": {
            "t": "time"
          },
          "lhs": "fluid.state.pressure[t]",
          "rhs": "state.pressure[t]",
          "determines": "fluid.state.pressure[t]"
        },
        "enthalpy": {
          "for_each": {
            "t": "time"
          },
          "lhs": "fluid.state.enthalpy[t]",
          "rhs": "state.enthalpy[t]",
          "determines": "fluid.state.enthalpy[t]"
        },
        "vapor_fraction": {
          "for_each": {
            "t": "time"
          },
          "lhs": "properties.vapor_fraction[t]",
          "rhs": "fluid.properties.vapor_fraction[t]",
          "determines": "properties.vapor_fraction[t]"
        },
        "temperature_bubble": {
          "for_each": {
            "t": "time"
          },
          "lhs": "properties.temperature_bubble[t]",
          "rhs": "fluid.properties.temperature_bubble[t]",
          "determines": "properties.temperature_bubble[t]"
        },
        "temperature_dew": {
          "for_each": {
            "t": "time"
          },
          "lhs": "properties.temperature_dew[t]",
          "rhs": "fluid.properties.temperature_dew[t]",
          "determines": "properties.temperature_dew[t]"
        }
      },
      "connections": {}
    }
  },
  "domains": {
    "time": {
      "kind": "time"
    }
  }
}
