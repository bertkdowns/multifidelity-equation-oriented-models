{
  "id": "milk_evaporator",
  "description": "Topology scaffold of the milk MVR evaporator. Aggregate balances are unclosed; detailed structure omits milk composition, phase equilibrium, carryover and effectiveness closure. Not numerically equivalent to the existing case.",
  "structs": {
    "milk_inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05
        }
      }
    },
    "milk_outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05
        }
      }
    },
    "water_outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "mvr_power": {
          "unit": "W",
          "dimensions": [
            "time"
          ],
          "scale": 0.0001
        },
        "effectiveness": {
          "unit": "dimensionless",
          "dimensions": [
            "time"
          ],
          "scale": 1
        }
      }
    }
  },
  "relationships": {
    "aggregate": {
      "models": {},
      "constraints": {
        "mass_balance": {
          "lhs": "milk_inlet.flow[t]",
          "rhs": "milk_outlet.flow[t] + water_outlet.flow[t]",
          "determines": "water_outlet.flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "energy_balance": {
          "lhs": "milk_inlet.flow[t] * milk_inlet.enthalpy[t] + parameters.mvr_power[t]",
          "rhs": "milk_outlet.flow[t] * milk_outlet.enthalpy[t] + water_outlet.flow[t] * water_outlet.enthalpy[t]",
          "determines": "water_outlet.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        }
      },
      "connections": {}
    },
    "detailed": {
      "models": {
        "valve": {
          "model": "valve",
          "domain_bindings": {
            "time": "time"
          }
        },
        "heat_exchanger": {
          "model": "heat_exchanger",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "HotSideProperties": {
              "model": "water_property_package"
            },
            "ColdSideProperties": {
              "model": "water_property_package"
            }
          }
        },
        "separator": {
          "model": "flash_separator",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "FluidProperties": {
              "model": "helmholtz_water_ph"
            }
          }
        },
        "translator": {
          "model": "translator",
          "domain_bindings": {
            "time": "time"
          }
        },
        "mvr": {
          "model": "compressor",
          "model_arguments": {
            "FluidProperties": {
              "model": "water_property_package"
            }
          },
          "domain_bindings": {
            "time": "time"
          }
        }
      },
      "constraints": {
        "mvr_power_balance": {
          "lhs": "parameters.mvr_power[t]",
          "rhs": "mvr.performance.work[t]",
          "determines": "mvr.parameters.pressure_rise[t]",
          "for_each": {
            "t": "time"
          }
        }
      },
      "connections": {
        "link_1": {
          "from": "milk_inlet",
          "to": "valve.inlet"
        },
        "link_2": {
          "from": "valve.outlet",
          "to": "heat_exchanger.cold_inlet"
        },
        "link_3": {
          "from": "heat_exchanger.cold_outlet",
          "to": "separator.inlet"
        },
        "link_4": {
          "from": "separator.liquid",
          "to": "milk_outlet"
        },
        "link_5": {
          "from": "separator.vapor",
          "to": "translator.inlet"
        },
        "link_6": {
          "from": "translator.outlet",
          "to": "mvr.inlet"
        },
        "link_7": {
          "from": "mvr.outlet",
          "to": "heat_exchanger.hot_inlet"
        },
        "link_8": {
          "from": "heat_exchanger.hot_outlet",
          "to": "water_outlet"
        }
      }
    }
  },
  "domains": {
    "time": {
      "kind": "time"
    }
  }
}
