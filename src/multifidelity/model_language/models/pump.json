{
  "id": "pump",
  "description": "Efficiency-based steady pressure changer using property-model arguments; adiabatic energy balance, no kinetic or potential energy changes.",
  "model_parameters": {
    "FluidProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa"
            },
            "enthalpy": {
              "unit": "J/kg"
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "density": {
              "unit": "kg/m**3"
            }
          }
        }
      }
    }
  },
  "structs": {
    "inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "pressure_rise": {
          "unit": "Pa",
          "bounds": {
            "min": 0
          }
        },
        "efficiency": {
          "unit": "dimensionless",
          "bounds": {
            "min": 1e-06,
            "max": 1
          }
        }
      }
    },
    "performance": {
      "direction": "output",
      "variables": {
        "work": {
          "unit": "W",
          "bounds": {
            "min": 0
          }
        },
        "fluid_work": {
          "unit": "W"
        }
      }
    }
  },
  "relationships": {
    "incompressible": {
      "models": {
        "outlet_state": {
          "model_parameter": "FluidProperties"
        }
      },
      "constraints": {
        "mass_balance": {
          "lhs": "outlet.flow",
          "rhs": "inlet.flow",
          "determines": "outlet.flow"
        },
        "pressure": {
          "lhs": "outlet.pressure",
          "rhs": "inlet.pressure + parameters.pressure_rise",
          "determines": "outlet.pressure"
        },
        "energy_balance": {
          "lhs": "outlet.flow * outlet.enthalpy",
          "rhs": "inlet.flow * inlet.enthalpy + performance.work",
          "determines": "outlet.enthalpy"
        },
        "outlet_pressure": {
          "lhs": "outlet_state.state.pressure",
          "rhs": "outlet.pressure",
          "determines": "outlet_state.state.pressure"
        },
        "outlet_enthalpy": {
          "lhs": "outlet_state.state.enthalpy",
          "rhs": "outlet.enthalpy",
          "determines": "outlet_state.state.enthalpy"
        },
        "fluid_work": {
          "lhs": "performance.fluid_work",
          "rhs": "parameters.pressure_rise * outlet.flow / outlet_state.properties.density",
          "determines": "performance.fluid_work"
        },
        "efficiency": {
          "lhs": "parameters.efficiency * performance.work",
          "rhs": "performance.fluid_work",
          "determines": "performance.work"
        }
      },
      "connections": {}
    }
  }
}
