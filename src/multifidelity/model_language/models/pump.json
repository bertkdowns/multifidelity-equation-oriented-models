{
  "id": "pump",
  "description": "Efficiency-based steady pressure changer using property-model arguments; adiabatic energy balance, no kinetic or potential energy changes.",
  "model_parameters": {
    "FluidProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa",
              "dimensions": [
                "time"
              ]
            },
            "enthalpy": {
              "unit": "J/kg",
              "dimensions": [
                "time"
              ]
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "density": {
              "unit": "kg/m**3",
              "dimensions": [
                "time"
              ]
            },
            "heat_capacity": {
              "unit": "J/kg/K",
              "dimensions": [
                "time"
              ]
            },
            "temperature": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            },
            "entropy": {
              "unit": "J/kg/K",
              "dimensions": [
                "time"
              ]
            },
            "vapor_fraction": {
              "unit": "dimensionless",
              "dimensions": [
                "time"
              ]
            },
            "temperature_bubble": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            },
            "temperature_dew": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            }
          }
        }
      }
    }
  },
  "structs": {
    "inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "pressure_rise": {
          "unit": "Pa",
          "bounds": {
            "min": 0
          },
          "dimensions": [
            "time"
          ]
        },
        "efficiency": {
          "unit": "dimensionless",
          "bounds": {
            "min": 1e-06,
            "max": 1
          },
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "performance": {
      "direction": "output",
      "variables": {
        "work": {
          "unit": "W",
          "bounds": {
            "min": 0
          },
          "dimensions": [
            "time"
          ]
        },
        "fluid_work": {
          "unit": "W",
          "dimensions": [
            "time"
          ]
        }
      }
    }
  },
  "relationships": {
    "incompressible": {
      "models": {
        "outlet_state": {
          "model": "state_block",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "FluidProperties": {
              "model_parameter": "FluidProperties"
            }
          }
        }
      },
      "constraints": {
        "mass_balance": {
          "lhs": "outlet.flow[t]",
          "rhs": "inlet.flow[t]",
          "determines": "outlet.flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "pressure": {
          "lhs": "outlet.pressure[t]",
          "rhs": "inlet.pressure[t] + parameters.pressure_rise[t]",
          "determines": "outlet.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "energy_balance": {
          "lhs": "outlet.flow[t] * outlet.enthalpy[t]",
          "rhs": "inlet.flow[t] * inlet.enthalpy[t] + performance.work[t]",
          "determines": "outlet.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "fluid_work": {
          "lhs": "performance.fluid_work[t]",
          "rhs": "parameters.pressure_rise[t] * outlet.flow[t] / outlet_state.properties.density[t]",
          "determines": "performance.fluid_work[t]",
          "for_each": {
            "t": "time"
          }
        },
        "efficiency": {
          "lhs": "parameters.efficiency[t] * performance.work[t]",
          "rhs": "performance.fluid_work[t]",
          "determines": "performance.work[t]",
          "for_each": {
            "t": "time"
          }
        }
      },
      "connections": {
        "outlet_state": {
          "from": "outlet",
          "to": "outlet_state.state"
        }
      }
    }
  },
  "domains": {
    "time": {
      "kind": "time"
    }
  }
}
