{
  "id": "en12900_compressor_map",
  "description": "Extracted Ahuora EN 12900 catalogue polynomials for propane; dew temperatures in K. Cooling/heating capacity and COP are rated map metrics, not actual compressor duty. Speed is discrete and no application envelope is supplied.",
  "structs": {
    "temperatures": {
      "direction": "input",
      "variables": {
        "evaporating": {
          "unit": "K",
          "dimensions": [
            "time"
          ],
          "scale": 0.0033333333333333335
        },
        "condensing": {
          "unit": "K",
          "dimensions": [
            "time"
          ],
          "scale": 0.0033333333333333335
        }
      }
    },
    "performance": {
      "direction": "output",
      "variables": {
        "mass_flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1
        },
        "electrical_power": {
          "unit": "W",
          "dimensions": [
            "time"
          ],
          "scale": 0.0001
        },
        "capacity": {
          "unit": "W",
          "dimensions": [
            "time"
          ],
          "scale": 0.0001
        },
        "current": {
          "unit": "A",
          "dimensions": [
            "time"
          ],
          "scale": 0.1
        },
        "rated_cop": {
          "unit": "dimensionless",
          "dimensions": [
            "time"
          ],
          "scale": 1
        }
      }
    },
    "rating": {
      "direction": "output",
      "variables": {
        "superheat": {
          "unit": "K",
          "dimensions": [
            "time"
          ],
          "scale": 0.1
        },
        "subcooling": {
          "unit": "K",
          "dimensions": [
            "time"
          ],
          "scale": 0.1
        }
      }
    }
  },
  "relationships": {
    "cooling_60rps": {
      "external": {
        "provider": "standard.en12900_map",
        "config": {
          "performance_map": "spb172fnkmt_cooling_pcs661ab",
          "speed_rps": 60
        },
        "dependencies": {
          "performance.mass_flow": [
            "temperatures.evaporating",
            "temperatures.condensing"
          ],
          "performance.electrical_power": [
            "temperatures.evaporating",
            "temperatures.condensing"
          ],
          "performance.capacity": [
            "temperatures.evaporating",
            "temperatures.condensing"
          ],
          "performance.current": [
            "temperatures.evaporating",
            "temperatures.condensing"
          ],
          "performance.rated_cop": [
            "temperatures.evaporating",
            "temperatures.condensing"
          ],
          "rating.superheat": [],
          "rating.subcooling": []
        }
      }
    }
  },
  "domains": {
    "time": {
      "kind": "time"
    }
  }
}
