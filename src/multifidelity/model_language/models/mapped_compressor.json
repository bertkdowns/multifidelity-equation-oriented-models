{
  "id": "mapped_compressor",
  "description": "JSON compressor composition with replaceable PH thermodynamics and performance map. Predicts flow from dew temperatures, preserves Ahuora motor/adiabatic balance and superheat metrics. Map must match fluid; rated capacity is diagnostic, not imposed as duty.",
  "model_parameters": {
    "FluidProperties": {
      "requires": {
        "state": {
          "direction": "input",
          "variables": {
            "pressure": {
              "unit": "Pa",
              "dimensions": [
                "time"
              ]
            },
            "enthalpy": {
              "unit": "J/kg",
              "dimensions": [
                "time"
              ]
            }
          }
        },
        "properties": {
          "direction": "output",
          "variables": {
            "temperature": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            },
            "temperature_bubble": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            },
            "temperature_dew": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            }
          }
        }
      }
    },
    "PerformanceMap": {
      "requires": {
        "temperatures": {
          "direction": "input",
          "variables": {
            "evaporating": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            },
            "condensing": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            }
          }
        },
        "performance": {
          "direction": "output",
          "variables": {
            "mass_flow": {
              "unit": "kg/s",
              "dimensions": [
                "time"
              ]
            },
            "electrical_power": {
              "unit": "W",
              "dimensions": [
                "time"
              ]
            },
            "capacity": {
              "unit": "W",
              "dimensions": [
                "time"
              ]
            },
            "current": {
              "unit": "A",
              "dimensions": [
                "time"
              ]
            },
            "rated_cop": {
              "unit": "dimensionless",
              "dimensions": [
                "time"
              ]
            }
          }
        },
        "rating": {
          "direction": "output",
          "variables": {
            "superheat": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            },
            "subcooling": {
              "unit": "K",
              "dimensions": [
                "time"
              ]
            }
          }
        }
      }
    }
  },
  "structs": {
    "inlet": {
      "direction": "input",
      "variables": {
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "pressure_rise": {
          "unit": "Pa",
          "bounds": {
            "min": 0
          },
          "dimensions": [
            "time"
          ]
        },
        "motor_efficiency": {
          "unit": "dimensionless",
          "bounds": {
            "min": 1e-06,
            "max": 1
          },
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "performance": {
      "direction": "output",
      "variables": {
        "mass_flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "electrical_power": {
          "unit": "W",
          "dimensions": [
            "time"
          ]
        },
        "shaft_power": {
          "unit": "W",
          "dimensions": [
            "time"
          ]
        },
        "rated_capacity": {
          "unit": "W",
          "dimensions": [
            "time"
          ]
        },
        "current": {
          "unit": "A",
          "dimensions": [
            "time"
          ]
        },
        "rated_cop": {
          "unit": "dimensionless",
          "dimensions": [
            "time"
          ]
        },
        "pressure_ratio": {
          "unit": "dimensionless",
          "dimensions": [
            "time"
          ]
        },
        "actual_superheat": {
          "unit": "K",
          "dimensions": [
            "time"
          ]
        },
        "superheat_deviation": {
          "unit": "K",
          "dimensions": [
            "time"
          ]
        },
        "rated_superheat": {
          "unit": "K",
          "dimensions": [
            "time"
          ]
        },
        "rated_subcooling": {
          "unit": "K",
          "dimensions": [
            "time"
          ]
        }
      }
    }
  },
  "relationships": {
    "mapped": {
      "models": {
        "inlet_state": {
          "model_parameter": "FluidProperties",
          "domain_bindings": {
            "time": "time"
          }
        },
        "outlet_state": {
          "model_parameter": "FluidProperties",
          "domain_bindings": {
            "time": "time"
          }
        },
        "map": {
          "model_parameter": "PerformanceMap",
          "domain_bindings": {
            "time": "time"
          }
        }
      },
      "constraints": {
        "pressure": {
          "lhs": "outlet.pressure[t]",
          "rhs": "inlet.pressure[t] + parameters.pressure_rise[t]",
          "determines": "outlet.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "inlet_state_pressure": {
          "lhs": "inlet_state.state.pressure[t]",
          "rhs": "inlet.pressure[t]",
          "determines": "inlet_state.state.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "inlet_state_enthalpy": {
          "lhs": "inlet_state.state.enthalpy[t]",
          "rhs": "inlet.enthalpy[t]",
          "determines": "inlet_state.state.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "outlet_state_pressure": {
          "lhs": "outlet_state.state.pressure[t]",
          "rhs": "outlet.pressure[t]",
          "determines": "outlet_state.state.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "outlet_state_enthalpy": {
          "lhs": "outlet_state.state.enthalpy[t]",
          "rhs": "outlet.enthalpy[t]",
          "determines": "outlet_state.state.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "evaporating_temperature": {
          "lhs": "map.temperatures.evaporating[t]",
          "rhs": "inlet_state.properties.temperature_dew[t]",
          "determines": "map.temperatures.evaporating[t]",
          "for_each": {
            "t": "time"
          }
        },
        "condensing_temperature": {
          "lhs": "map.temperatures.condensing[t]",
          "rhs": "outlet_state.properties.temperature_dew[t]",
          "determines": "map.temperatures.condensing[t]",
          "for_each": {
            "t": "time"
          }
        },
        "mass_flow": {
          "lhs": "performance.mass_flow[t]",
          "rhs": "map.performance.mass_flow[t]",
          "determines": "performance.mass_flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "electrical_power": {
          "lhs": "performance.electrical_power[t]",
          "rhs": "map.performance.electrical_power[t]",
          "determines": "performance.electrical_power[t]",
          "for_each": {
            "t": "time"
          }
        },
        "rated_capacity": {
          "lhs": "performance.rated_capacity[t]",
          "rhs": "map.performance.capacity[t]",
          "determines": "performance.rated_capacity[t]",
          "for_each": {
            "t": "time"
          }
        },
        "current": {
          "lhs": "performance.current[t]",
          "rhs": "map.performance.current[t]",
          "determines": "performance.current[t]",
          "for_each": {
            "t": "time"
          }
        },
        "rated_cop": {
          "lhs": "performance.rated_cop[t]",
          "rhs": "map.performance.rated_cop[t]",
          "determines": "performance.rated_cop[t]",
          "for_each": {
            "t": "time"
          }
        },
        "flow": {
          "lhs": "outlet.flow[t]",
          "rhs": "performance.mass_flow[t]",
          "determines": "outlet.flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "shaft_power": {
          "lhs": "performance.shaft_power[t]",
          "rhs": "parameters.motor_efficiency[t] * performance.electrical_power[t]",
          "determines": "performance.shaft_power[t]",
          "for_each": {
            "t": "time"
          }
        },
        "energy": {
          "lhs": "outlet.flow[t] * outlet.enthalpy[t]",
          "rhs": "performance.mass_flow[t] * inlet.enthalpy[t] + performance.shaft_power[t]",
          "determines": "outlet.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "pressure_ratio": {
          "lhs": "performance.pressure_ratio[t] * inlet.pressure[t]",
          "rhs": "outlet.pressure[t]",
          "determines": "performance.pressure_ratio[t]",
          "for_each": {
            "t": "time"
          }
        },
        "rated_superheat": {
          "lhs": "performance.rated_superheat[t]",
          "rhs": "map.rating.superheat[t]",
          "determines": "performance.rated_superheat[t]",
          "for_each": {
            "t": "time"
          }
        },
        "rated_subcooling": {
          "lhs": "performance.rated_subcooling[t]",
          "rhs": "map.rating.subcooling[t]",
          "determines": "performance.rated_subcooling[t]",
          "for_each": {
            "t": "time"
          }
        },
        "actual_superheat": {
          "lhs": "performance.actual_superheat[t]",
          "rhs": "inlet_state.properties.temperature[t] - inlet_state.properties.temperature_dew[t]",
          "determines": "performance.actual_superheat[t]",
          "for_each": {
            "t": "time"
          }
        },
        "superheat_deviation": {
          "lhs": "performance.superheat_deviation[t]",
          "rhs": "performance.actual_superheat[t] - performance.rated_superheat[t]",
          "determines": "performance.superheat_deviation[t]",
          "for_each": {
            "t": "time"
          }
        }
      }
    }
  },
  "domains": {
    "time": {
      "kind": "time"
    }
  }
}
