{
  "id": "flash_separator",
  "description": "Topology scaffold: prescribed flow split; no phase equilibrium or composition closure.",
  "structs": {
    "inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "fraction": {
          "unit": "dimensionless",
          "bounds": {
            "min": 0,
            "max": 1
          }
        }
      }
    },
    "liquid": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "vapor": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    }
  },
  "relationships": {
    "split": {
      "models": {},
      "constraints": {
        "liquid_flow_split": {
          "lhs": "liquid.flow",
          "rhs": "inlet.flow * parameters.fraction",
          "determines": "liquid.flow"
        },
        "vapor_mass_balance": {
          "lhs": "vapor.flow",
          "rhs": "inlet.flow - liquid.flow",
          "determines": "vapor.flow"
        },
        "liquid_pressure_balance": {
          "lhs": "liquid.pressure",
          "rhs": "inlet.pressure",
          "determines": "liquid.pressure"
        },
        "liquid_enthalpy_balance": {
          "lhs": "liquid.enthalpy",
          "rhs": "inlet.enthalpy",
          "determines": "liquid.enthalpy"
        },
        "vapor_pressure_balance": {
          "lhs": "vapor.pressure",
          "rhs": "inlet.pressure",
          "determines": "vapor.pressure"
        },
        "vapor_enthalpy_balance": {
          "lhs": "vapor.enthalpy",
          "rhs": "inlet.enthalpy",
          "determines": "vapor.enthalpy"
        }
      },
      "connections": {}
    }
  }
}
