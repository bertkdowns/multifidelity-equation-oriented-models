{
  "id": "flash_separator",
  "description": "Topology scaffold: prescribed flow split; no phase equilibrium or composition closure.",
  "structs": {
    "inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "parameters": {
      "direction": "input",
      "variables": {
        "fraction": {
          "unit": "dimensionless",
          "bounds": {
            "min": 0,
            "max": 1
          },
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "liquid": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "vapor": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    }
  },
  "relationships": {
    "split": {
      "models": {},
      "constraints": {
        "liquid_flow_split": {
          "lhs": "liquid.flow[t]",
          "rhs": "inlet.flow[t] * parameters.fraction[t]",
          "determines": "liquid.flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "vapor_mass_balance": {
          "lhs": "vapor.flow[t]",
          "rhs": "inlet.flow[t] - liquid.flow[t]",
          "determines": "vapor.flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "liquid_pressure_balance": {
          "lhs": "liquid.pressure[t]",
          "rhs": "inlet.pressure[t]",
          "determines": "liquid.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "liquid_enthalpy_balance": {
          "lhs": "liquid.enthalpy[t]",
          "rhs": "inlet.enthalpy[t]",
          "determines": "liquid.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        },
        "vapor_pressure_balance": {
          "lhs": "vapor.pressure[t]",
          "rhs": "inlet.pressure[t]",
          "determines": "vapor.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "vapor_enthalpy_balance": {
          "lhs": "vapor.enthalpy[t]",
          "rhs": "inlet.enthalpy[t]",
          "determines": "vapor.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        }
      },
      "connections": {}
    }
  },
  "domains": {
    "time": {
      "kind": "time"
    }
  }
}
