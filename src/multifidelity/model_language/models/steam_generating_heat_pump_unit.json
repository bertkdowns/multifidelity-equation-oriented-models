{
  "id": "steam_generating_heat_pump_unit",
  "description": "Three-water-circuit SGHP unit: aggregate COP or refrigerant cycle with n-butane Helmholtz compressor properties. Helmholtz inlet water states support temperature-based specifications. Exchanger heat transfer remains lumped.",
  "domains": {
    "time": {
      "kind": "time"
    }
  },
  "structs": {
    "source_inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1,
          "default": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 200000
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 100000
        }
      }
    },
    "source_outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1,
          "default": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 200000
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 100000
        }
      }
    },
    "hot_inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1,
          "default": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 200000
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 100000
        }
      }
    },
    "hot_outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1,
          "default": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 200000
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 100000
        }
      }
    },
    "warm_inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1,
          "default": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 200000
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 100000
        }
      }
    },
    "warm_outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ],
          "scale": 1,
          "default": 1
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 200000
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "scale": 1e-05,
          "default": 100000
        }
      }
    },
    "performance": {
      "direction": "output",
      "variables": {
        "heating_duty": {
          "unit": "W",
          "dimensions": [
            "time"
          ],
          "scale": 0.0001,
          "default": 3000
        },
        "hot_water_duty": {
          "unit": "W",
          "dimensions": [
            "time"
          ],
          "scale": 0.0001,
          "default": 3000
        },
        "warm_water_duty": {
          "unit": "W",
          "dimensions": [
            "time"
          ],
          "scale": 0.0001,
          "default": 0
        },
        "cooling_duty": {
          "unit": "W",
          "dimensions": [
            "time"
          ],
          "scale": 0.0001,
          "default": 2000
        },
        "electrical_power": {
          "unit": "W",
          "dimensions": [
            "time"
          ],
          "scale": 0.0001,
          "default": 1000
        },
        "cop": {
          "unit": "dimensionless",
          "dimensions": [
            "time"
          ],
          "scale": 1,
          "default": 3
        }
      }
    }
  },
  "relationships": {
    "aggregate": {
      "models": {
        "cop_model": {
          "model": "prescribed_cop",
          "domain_bindings": {
            "time": "time"
          }
        },
        "power_model": {
          "model": "prescribed_power",
          "domain_bindings": {
            "time": "time"
          }
        },
        "warm_water_heater": {
          "model": "thermal_conditioner",
          "domain_bindings": {
            "time": "time"
          }
        },
        "source_inlet_state": {
          "model": "state_block",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "FluidProperties": {
              "model": "helmholtz_water_ph"
            }
          }
        },
        "hot_inlet_state": {
          "model": "state_block",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "FluidProperties": {
              "model": "helmholtz_water_ph"
            }
          }
        },
        "warm_inlet_state": {
          "model": "state_block",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "FluidProperties": {
              "model": "helmholtz_water_ph"
            }
          }
        }
      },
      "constraints": {
        "source_flow": {
          "for_each": {
            "t": "time"
          },
          "lhs": "source_outlet.flow[t]",
          "rhs": "source_inlet.flow[t]",
          "determines": "source_outlet.flow[t]"
        },
        "source_pressure": {
          "for_each": {
            "t": "time"
          },
          "lhs": "source_outlet.pressure[t]",
          "rhs": "source_inlet.pressure[t]",
          "determines": "source_outlet.pressure[t]"
        },
        "hot_flow": {
          "for_each": {
            "t": "time"
          },
          "lhs": "hot_outlet.flow[t]",
          "rhs": "hot_inlet.flow[t]",
          "determines": "hot_outlet.flow[t]"
        },
        "hot_pressure": {
          "for_each": {
            "t": "time"
          },
          "lhs": "hot_outlet.pressure[t]",
          "rhs": "hot_inlet.pressure[t]",
          "determines": "hot_outlet.pressure[t]"
        },
        "power": {
          "for_each": {
            "t": "time"
          },
          "lhs": "performance.electrical_power[t]",
          "rhs": "power_model.performance.electrical_power[t]",
          "determines": "performance.electrical_power[t]"
        },
        "cop": {
          "for_each": {
            "t": "time"
          },
          "lhs": "performance.cop[t]",
          "rhs": "cop_model.performance.cop[t]",
          "determines": "performance.cop[t]"
        },
        "heating": {
          "for_each": {
            "t": "time"
          },
          "lhs": "performance.heating_duty[t]",
          "rhs": "performance.cop[t] * performance.electrical_power[t]",
          "determines": "performance.heating_duty[t]"
        },
        "warm_duty": {
          "for_each": {
            "t": "time"
          },
          "lhs": "performance.warm_water_duty[t]",
          "rhs": "warm_water_heater.parameters.heat_duty[t]",
          "determines": "performance.warm_water_duty[t]"
        },
        "hot_duty": {
          "for_each": {
            "t": "time"
          },
          "lhs": "performance.hot_water_duty[t]",
          "rhs": "performance.heating_duty[t] - performance.warm_water_duty[t]",
          "determines": "performance.hot_water_duty[t]"
        },
        "cooling": {
          "for_each": {
            "t": "time"
          },
          "lhs": "performance.cooling_duty[t]",
          "rhs": "performance.heating_duty[t] - performance.electrical_power[t]",
          "determines": "performance.cooling_duty[t]"
        },
        "source_energy": {
          "for_each": {
            "t": "time"
          },
          "lhs": "source_outlet.flow[t] * source_outlet.enthalpy[t]",
          "rhs": "source_inlet.flow[t] * source_inlet.enthalpy[t] - performance.cooling_duty[t]",
          "determines": "source_outlet.enthalpy[t]"
        },
        "hot_energy": {
          "for_each": {
            "t": "time"
          },
          "lhs": "hot_outlet.flow[t] * hot_outlet.enthalpy[t]",
          "rhs": "hot_inlet.flow[t] * hot_inlet.enthalpy[t] + performance.hot_water_duty[t]",
          "determines": "hot_outlet.enthalpy[t]"
        }
      },
      "connections": {
        "warm_in": {
          "from": "warm_inlet",
          "to": "warm_water_heater.inlet"
        },
        "warm_out": {
          "from": "warm_water_heater.outlet",
          "to": "warm_outlet"
        },
        "source_inlet_state": {
          "from": "source_inlet",
          "to": "source_inlet_state.state"
        },
        "hot_inlet_state": {
          "from": "hot_inlet",
          "to": "hot_inlet_state.state"
        },
        "warm_inlet_state": {
          "from": "warm_inlet",
          "to": "warm_inlet_state.state"
        }
      }
    },
    "cycle": {
      "models": {
        "compressor": {
          "model": "compressor",
          "model_arguments": {
            "FluidProperties": {
              "model": "helmholtz_butane_ph"
            }
          },
          "domain_bindings": {
            "time": "time"
          }
        },
        "condenser": {
          "model": "heat_exchanger",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "HotSideProperties": {
              "model": "helmholtz_butane_ph"
            },
            "ColdSideProperties": {
              "model": "helmholtz_water_ph"
            }
          }
        },
        "subcooler": {
          "model": "heat_exchanger",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "HotSideProperties": {
              "model": "helmholtz_butane_ph"
            },
            "ColdSideProperties": {
              "model": "helmholtz_water_ph"
            }
          }
        },
        "ihx": {
          "model": "heat_exchanger",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "HotSideProperties": {
              "model": "helmholtz_butane_ph"
            },
            "ColdSideProperties": {
              "model": "helmholtz_butane_ph"
            }
          }
        },
        "expansion_valve": {
          "model": "valve",
          "domain_bindings": {
            "time": "time"
          }
        },
        "evaporator": {
          "model": "heat_exchanger",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "HotSideProperties": {
              "model": "helmholtz_water_ph"
            },
            "ColdSideProperties": {
              "model": "helmholtz_butane_ph"
            }
          }
        },
        "source_inlet_state": {
          "model": "state_block",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "FluidProperties": {
              "model": "helmholtz_water_ph"
            }
          }
        },
        "hot_inlet_state": {
          "model": "state_block",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "FluidProperties": {
              "model": "helmholtz_water_ph"
            }
          }
        },
        "warm_inlet_state": {
          "model": "state_block",
          "domain_bindings": {
            "time": "time"
          },
          "model_arguments": {
            "FluidProperties": {
              "model": "helmholtz_water_ph"
            }
          }
        }
      },
      "constraints": {
        "power": {
          "for_each": {
            "t": "time"
          },
          "lhs": "performance.electrical_power[t]",
          "rhs": "compressor.performance.work[t]",
          "determines": "performance.electrical_power[t]"
        },
        "hot_water_duty": {
          "for_each": {
            "t": "time"
          },
          "lhs": "performance.hot_water_duty[t]",
          "rhs": "hot_outlet.flow[t] * hot_outlet.enthalpy[t] - hot_inlet.flow[t] * hot_inlet.enthalpy[t]",
          "determines": "performance.hot_water_duty[t]"
        },
        "warm_water_duty": {
          "for_each": {
            "t": "time"
          },
          "lhs": "performance.warm_water_duty[t]",
          "rhs": "warm_outlet.flow[t] * warm_outlet.enthalpy[t] - warm_inlet.flow[t] * warm_inlet.enthalpy[t]",
          "determines": "performance.warm_water_duty[t]"
        },
        "cooling_duty": {
          "for_each": {
            "t": "time"
          },
          "lhs": "performance.cooling_duty[t]",
          "rhs": "source_inlet.flow[t] * source_inlet.enthalpy[t] - source_outlet.flow[t] * source_outlet.enthalpy[t]",
          "determines": "performance.cooling_duty[t]"
        },
        "heating": {
          "for_each": {
            "t": "time"
          },
          "lhs": "performance.heating_duty[t]",
          "rhs": "performance.hot_water_duty[t] + performance.warm_water_duty[t]",
          "determines": "performance.heating_duty[t]"
        },
        "cop": {
          "for_each": {
            "t": "time"
          },
          "lhs": "performance.cop[t] * performance.electrical_power[t]",
          "rhs": "performance.heating_duty[t]",
          "determines": "performance.cop[t]"
        }
      },
      "connections": {
        "link_1": {
          "from": "compressor.outlet",
          "to": "condenser.hot_inlet"
        },
        "link_3": {
          "from": "condenser.hot_outlet",
          "to": "subcooler.hot_inlet"
        },
        "link_5": {
          "from": "subcooler.hot_outlet",
          "to": "ihx.hot_inlet"
        },
        "link_6": {
          "from": "evaporator.cold_outlet",
          "to": "ihx.cold_inlet"
        },
        "link_8": {
          "from": "expansion_valve.outlet",
          "to": "evaporator.cold_inlet"
        },
        "link_22": {
          "from": "ihx.cold_outlet",
          "to": "compressor.inlet"
        },
        "link_23": {
          "from": "ihx.hot_outlet",
          "to": "expansion_valve.inlet"
        },
        "source_in": {
          "from": "source_inlet",
          "to": "evaporator.hot_inlet"
        },
        "source_out": {
          "from": "evaporator.hot_outlet",
          "to": "source_outlet"
        },
        "hot_in": {
          "from": "hot_inlet",
          "to": "condenser.cold_inlet"
        },
        "hot_out": {
          "from": "condenser.cold_outlet",
          "to": "hot_outlet"
        },
        "warm_in": {
          "from": "warm_inlet",
          "to": "subcooler.cold_inlet"
        },
        "warm_out": {
          "from": "subcooler.cold_outlet",
          "to": "warm_outlet"
        },
        "source_inlet_state": {
          "from": "source_inlet",
          "to": "source_inlet_state.state"
        },
        "hot_inlet_state": {
          "from": "hot_inlet",
          "to": "hot_inlet_state.state"
        },
        "warm_inlet_state": {
          "from": "warm_inlet",
          "to": "warm_inlet_state.state"
        }
      }
    }
  }
}
