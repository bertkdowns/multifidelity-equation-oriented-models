{
  "id": "translator",
  "description": "Topology scaffold: identity translation, no composition or property-basis conversion.",
  "structs": {
    "inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    },
    "outlet": {
      "direction": "output",
      "variables": {
        "flow": {
          "unit": "kg/s"
        },
        "pressure": {
          "unit": "Pa"
        },
        "enthalpy": {
          "unit": "J/kg"
        }
      }
    }
  },
  "relationships": {
    "identity": {
      "models": {},
      "constraints": {
        "mass_balance": {
          "lhs": "outlet.flow",
          "rhs": "inlet.flow",
          "determines": "outlet.flow"
        },
        "pressure_balance": {
          "lhs": "outlet.pressure",
          "rhs": "inlet.pressure",
          "determines": "outlet.pressure"
        },
        "enthalpy_balance": {
          "lhs": "outlet.enthalpy",
          "rhs": "inlet.enthalpy",
          "determines": "outlet.enthalpy"
        }
      },
      "connections": {}
    }
  }
}
