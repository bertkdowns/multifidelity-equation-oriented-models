{
  "id": "helmholtz_water_ph",
  "description": "Ahuora pure-fluid mass-basis PH wrapper for h2o; phase viscosity Liq; pure-fluid bubble/dew temperatures coincide. Saturation intended below critical pressure.",
  "structs": {
    "state": {
      "direction": "input",
      "variables": {
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ],
          "default": 200000
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "default": 100000
        }
      }
    },
    "properties": {
      "direction": "output",
      "variables": {
        "density": {
          "unit": "kg/m**3",
          "dimensions": [
            "time"
          ],
          "default": 1000
        },
        "heat_capacity": {
          "unit": "J/kg/K",
          "dimensions": [
            "time"
          ],
          "default": 4200
        },
        "viscosity": {
          "unit": "Pa*s",
          "dimensions": [
            "time"
          ]
        },
        "temperature": {
          "unit": "K",
          "dimensions": [
            "time"
          ],
          "default": 300
        },
        "entropy": {
          "unit": "J/kg/K",
          "dimensions": [
            "time"
          ],
          "default": 1000
        },
        "vapor_fraction": {
          "unit": "dimensionless",
          "dimensions": [
            "time"
          ],
          "default": 0
        },
        "temperature_bubble": {
          "unit": "K",
          "dimensions": [
            "time"
          ],
          "default": 373.15
        },
        "temperature_dew": {
          "unit": "K",
          "dimensions": [
            "time"
          ],
          "default": 373.15
        },
        "enthalpy_liquid_sat": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "default": 420000
        },
        "enthalpy_vapor_sat": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "default": 2675000
        },
        "enthalpy_liquid": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "default": 100000
        },
        "enthalpy_vapor": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ],
          "default": 2675000
        }
      }
    }
  },
  "relationships": {
    "helmholtz": {
      "external": {
        "provider": "standard.helmholtz_ph",
        "config": {
          "fluid": "h2o",
          "viscosity_phase": "Liq"
        },
        "dependencies": {
          "properties.density": [
            "state.pressure",
            "state.enthalpy"
          ],
          "properties.heat_capacity": [
            "state.pressure",
            "state.enthalpy"
          ],
          "properties.viscosity": [
            "state.pressure",
            "state.enthalpy"
          ],
          "properties.temperature": [
            "state.pressure",
            "state.enthalpy"
          ],
          "properties.entropy": [
            "state.pressure",
            "state.enthalpy"
          ],
          "properties.vapor_fraction": [
            "state.pressure",
            "state.enthalpy"
          ],
          "properties.temperature_bubble": [
            "state.pressure"
          ],
          "properties.temperature_dew": [
            "state.pressure"
          ],
          "properties.enthalpy_liquid_sat": [
            "state.pressure"
          ],
          "properties.enthalpy_vapor_sat": [
            "state.pressure"
          ],
          "properties.enthalpy_liquid": [
            "state.pressure",
            "state.enthalpy"
          ],
          "properties.enthalpy_vapor": [
            "state.pressure",
            "state.enthalpy"
          ]
        }
      }
    }
  },
  "domains": {
    "time": {
