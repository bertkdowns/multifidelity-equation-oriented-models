        },
        "link_15": {
          "from": "cooling_exchanger.hot_outlet",
          "to": "warm_water_mixer.main"
        },
        "link_16": {
          "from": "splitter.main",
          "to": "cooling_exchanger.hot_inlet"
        },
        "link_17": {
          "from": "splitter.branch",
          "to": "hot_water_mixer.makeup"
        },
        "link_18": {
          "from": "warm_water_mixer.outlet",
          "to": "warm_water_pump.inlet"
        },
        "link_19": {
          "from": "source_pump.outlet",
          "to": "evaporator.hot_inlet"
        },
        "link_20": {
          "from": "source_heater.outlet",
          "to": "source_tank.inlet"
        },
        "link_21": {
          "from": "source_tank.outlet",
          "to": "source_valve.inlet"
        },
        "link_22": {
          "from": "ihx.cold_outlet",
          "to": "compressor.inlet"
        },
        "link_23": {
          "from": "ihx.hot_outlet",
          "to": "expansion_valve.inlet"
        },
        "link_24": {
          "from": "source_valve.outlet",
          "to": "source_pump.inlet"
        },
        "makeup_feed": {
          "from": "makeup_inlet",
          "to": "warm_water_mixer.makeup"
        },
        "steam_export": {
          "from": "steam_valve.outlet",
          "to": "steam_outlet"
        }
      }
    },
    "aggregate": {
      "models": {
        "cop_model": {
          "model": "prescribed_cop",
          "domain_bindings": {
            "time": "time"
          }
        },
        "power_model": {
          "model": "prescribed_power",
          "domain_bindings": {
            "time": "time"
          }
        }
      },
      "constraints": {
        "mass_balance": {
          "lhs": "steam_outlet.flow[t]",
          "rhs": "makeup_inlet.flow[t]",
          "determines": "steam_outlet.flow[t]",
          "for_each": {
            "t": "time"
          }
        },
        "pressure": {
          "lhs": "steam_outlet.pressure[t]",
          "rhs": "makeup_inlet.pressure[t]",
          "determines": "steam_outlet.pressure[t]",
          "for_each": {
            "t": "time"
          }
        },
        "energy_balance": {
          "lhs": "steam_outlet.flow[t] * steam_outlet.enthalpy[t]",
          "rhs": "makeup_inlet.flow[t] * makeup_inlet.enthalpy[t] + cop_model.performance.cop[t] * power_model.performance.electrical_power[t]",
          "determines": "steam_outlet.enthalpy[t]",
          "for_each": {
            "t": "time"
          }
        }
      },
      "connections": {}
    }
  },
  "domains": {
    "time": {
      "kind": "time"
    }
  }
}
