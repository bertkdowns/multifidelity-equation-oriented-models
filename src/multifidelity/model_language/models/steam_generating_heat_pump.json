{
  "id": "steam_generating_heat_pump",
  "description": "Steam-generating heat pump with aggregate COP/power and captured equipment-flowsheet alternatives. Illustrative equations; neither alternative guarantees steam phase equilibrium or calibrated numerical equivalence.",
  "structs": {
    "makeup_inlet": {
      "direction": "input",
      "variables": {
        "flow": {
          "unit": "kg/s",
          "dimensions": [
            "time"
          ]
        },
        "pressure": {
          "unit": "Pa",
          "dimensions": [
            "time"
          ]
        },
        "enthalpy": {
          "unit": "J/kg",
          "dimensions": [
            "time"
          ]
        }
      }
    },
    "steam_outlet": {
